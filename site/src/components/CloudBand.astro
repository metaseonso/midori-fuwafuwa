---
// A soft, puffy horizontal cloud band, built from overlapping circles —
// the same fluffy-silhouette language as the mascot. Decorative only.
interface Props {
  variant: "far" | "mid" | "near";
  fill: string;
  class?: string;
}
const { variant, fill, class: className } = Astro.props;

const puffs: Record<string, Array<[number, number, number]>> = {
  // [cx, cy, r]
  far: [
    [80, 160, 70], [220, 130, 95], [380, 155, 80], [540, 120, 100],
    [700, 150, 85], [860, 125, 95], [1020, 155, 80], [1180, 130, 100],
    [1340, 158, 78], [1500, 135, 90],
  ],
  mid: [
    [60, 190, 90], [250, 150, 120], [460, 185, 100], [660, 145, 130],
    [880, 180, 105], [1090, 150, 125], [1300, 185, 100], [1500, 155, 115],
  ],
  near: [
    [0, 220, 130], [230, 170, 150], [500, 215, 140], [770, 165, 160],
    [1040, 210, 145], [1300, 170, 155], [1560, 215, 135],
  ],
};

const shapes = puffs[variant];
---

<svg
  class={`cloud-band cloud-band--${variant} ${className ?? ""}`}
  viewBox="0 0 1600 300"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <g fill={fill}>
    {shapes.map(([cx, cy, r]) => (
      <circle cx={cx} cy={cy} r={r} />
    ))}
  </g>
</svg>

<style>
  .cloud-band {
    position: absolute;
    left: 0;
    width: 100%;
    height: auto;
    pointer-events: none;
  }
</style>
