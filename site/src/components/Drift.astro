---
// A single painted cloud bank, hanging in the descent.
//
// These are the depth cues. Some sit BEHIND the worlds (`layer="back"`),
// some pass IN FRONT of them (`layer="front"`) — that occlusion, not a
// difference in speed, is what makes the page read as deep.
//
// Full opacity, always. These are painted cream clouds on a cream ground;
// they are meant to read as soft relief in paper, not as haze. Dimming
// them is how this page has failed before.
import { withBase } from "../lib/url";

interface Props {
  src: string;
  /** vw */
  w: number;
  /** % of the parent section */
  top: string;
  left: string;
  /** How far it drifts across the whole scroll, in vh. Nearer drifts more. */
  drift: number;
  layer?: "back" | "front";
  flip?: boolean;
  breath?: number;
  ampX?: number;
  ampY?: number;
}

const {
  src, w, top, left, drift, layer = "back", flip = false,
  // Seconds for one ambient traverse, and how far it travels as a fraction of
  // its own width. 0 = still.
  breath = 0, ampX = 2, ampY = 6,
} = Astro.props;

// Start each cloud part-way through its own breath so they never move in step.
const delay = breath > 0 ? -(((breath * 0.37 * (SIZES_SEED(src))) % breath).toFixed(2)) : 0;
function SIZES_SEED(s: string) { let n = 0; for (const ch of s) n += ch.charCodeAt(0); return n % 7; }

// Intrinsic pixel sizes of the painted plates. These have to be on the tag:
// an absolutely-positioned image sized only by CSS width is 0px tall until
// it loads, so a lazy one never intersects the viewport and never loads at
// all. The attributes give it an aspect-ratio box up front, which also
// means no layout shift when the art arrives.
const SIZES: Record<string, [number, number]> = {
  "sky-far": [1200, 670],
  "sky-mid": [1200, 670],
  "sky-near": [1200, 670],
  "sky-front": [1200, 670],
  "cloud-floor": [1200, 670],
  "motes": [760, 760],
  "island-base": [1000, 545],
  "island-misty": [900, 491],
};
const [iw, ih] = SIZES[src];
---

<div
  class:list={["drift", `drift--${layer}`]}
  style={`--w:${w}vw; --top:${top}; --left:${left}; --drift:${drift}vh;`}
>
  <img
    class:list={["drift__art", { "drift__art--breathes": breath > 0 }]}
    src={withBase(`/images/dream/${src}.webp`)}
    width={iw}
    height={ih}
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    style={`--sx:${flip ? -1 : 1}; --breath:${breath}s; --delay:${delay}s;
            --amp-x:${ampX}%; --amp-y:${ampY}%;`}
  />
</div>

<style>
  /* The scroll channels ride the WRAPPER; the ambient breath rides the art.
     They were on the same element, and the `animation` shorthand in the
     @supports block silently wiped the breath — the clouds looked static and
     measured as never changing. Two elements, no collision. */
  .drift {
    position: absolute;
    top: var(--top);
    left: var(--left);
    width: var(--w);
    max-width: none;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .drift--back  { z-index: 1; }
  .drift--front { z-index: 3; }

  .drift__art {
    width: 100%;
    height: auto;
    max-width: none;
    scale: var(--sx) 1;
  }

  /* Constant velocity, never eased: steady travel reads as endless, while an
     ease-in-out bob reads as a loop you can feel repeating. Vertical amplitude
     is generous because every plate used here dissolves top and bottom;
     horizontal stays small, because the wide plates have hard left and right
     edges that must never walk into frame. */
  .drift__art--breathes {
    animation: drift-breath var(--breath) linear var(--delay) infinite alternate;
  }
  @keyframes drift-breath {
    from { translate: calc(var(--amp-x) * -1) var(--amp-y); }
    to   { translate: var(--amp-x) calc(var(--amp-y) * -1); }
  }

  @supports (animation-timeline: scroll()) {
    /* `hang` carries the vertical travel; `recede` shrinks the cloud on the
       `scale` property so the two compose.

       Receding is the point. Sinking past a cloud deck means the deck falls
       AWAY — the horizon gets further off as you descend, while the fields
       below rise up and forward to meet you. */
    html.js .drift {
      animation: hang linear both, recede linear both;
      animation-timeline: scroll(root), scroll(root);
    }
  }
  @keyframes hang {
    from { transform: translate(-50%, calc(-50% + var(--drift))); }
    to   { transform: translate(-50%, calc(-50% - var(--drift))); }
  }
  @keyframes recede {
    from { scale: 1.18; }
    to   { scale: 0.74; }
  }

  @media (max-width: 860px) {
    .drift { width: calc(var(--w) * 2.1); }
  }

  @media (prefers-reduced-motion: reduce) {
    html.js .drift {
      animation: none !important;
      transform: translate(-50%, -50%) !important;
      scale: none !important;
    }
    .drift__art { animation: none !important; translate: none !important; }
  }
</style>
