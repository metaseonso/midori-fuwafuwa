---
// A single painted cloud bank, hanging in the descent.
//
// These are the depth cues. Some sit BEHIND the worlds (`layer="back"`),
// some pass IN FRONT of them (`layer="front"`) — that occlusion, not a
// difference in speed, is what makes the page read as deep.
//
// Full opacity, always. These are painted cream clouds on a cream ground;
// they are meant to read as soft relief in paper, not as haze. Dimming
// them is how this page has failed before.
import { withBase } from "../lib/url";

interface Props {
  src: string;
  /** vw */
  w: number;
  /** % of the parent section */
  top: string;
  left: string;
  /** How far it drifts across the whole scroll, in vh. Nearer drifts more. */
  drift: number;
  layer?: "back" | "front";
  flip?: boolean;
}

const { src, w, top, left, drift, layer = "back", flip = false } = Astro.props;

// Intrinsic pixel sizes of the painted plates. These have to be on the tag:
// an absolutely-positioned image sized only by CSS width is 0px tall until
// it loads, so a lazy one never intersects the viewport and never loads at
// all. The attributes give it an aspect-ratio box up front, which also
// means no layout shift when the art arrives.
const SIZES: Record<string, [number, number]> = {
  "sky-far": [1200, 670],
  "sky-mid": [1200, 670],
  "sky-near": [1200, 670],
  "sky-front": [1200, 670],
  "cloud-floor": [1200, 670],
  "motes": [760, 760],
  "island-base": [1000, 545],
  "island-misty": [900, 491],
};
const [iw, ih] = SIZES[src];
---

<img
  class:list={["drift", `drift--${layer}`, { "drift--flip": flip }]}
  src={withBase(`/images/dream/${src}.webp`)}
  width={iw}
  height={ih}
  alt=""
  aria-hidden="true"
  loading="lazy"
  decoding="async"
  style={`--w:${w}vw; --top:${top}; --left:${left}; --drift:${drift}vh; --sx:${flip ? -1 : 1};`}
/>

<style>
  .drift {
    position: absolute;
    top: var(--top);
    left: var(--left);
    width: var(--w);
    max-width: none;
    height: auto;
    pointer-events: none;
    /* scaleX comes last so the mirror happens about the cloud's own
       centre, after it has been positioned. Using the `scale` property
       instead would mirror the translate too, and throw it a full width
       off to the side. */
    transform: translate(-50%, -50%) scaleX(var(--sx));
    will-change: transform;
  }

  .drift--back  { z-index: 1; }
  .drift--front { z-index: 3; }

  @supports (animation-timeline: scroll()) {
    html.js .drift {
      animation: hang linear both;
      animation-timeline: scroll(root);
    }
  }
  @keyframes hang {
    from { transform: translate(-50%, calc(-50% + var(--drift))) scaleX(var(--sx)); }
    to   { transform: translate(-50%, calc(-50% - var(--drift))) scaleX(var(--sx)); }
  }

  @media (max-width: 860px) {
    .drift { width: calc(var(--w) * 2.1); }
  }

  @media (prefers-reduced-motion: reduce) {
    html.js .drift {
      animation: none !important;
      transform: translate(-50%, -50%) scaleX(var(--sx)) !important;
    }
  }
</style>
