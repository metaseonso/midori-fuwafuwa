---
// The opening of a dream field. Same world as the hub: the production's
// art rests on a painted cloud island and dissolves into the sky, the type
// floats free of any card, and the sky itself is the shared DreamSky.
// Leaving the hub should feel like descending further, never like landing
// on a different website.
import { withBase } from "../lib/url";

interface ImageProps {
  webp: string;
  fallback: string;
  width: number;
  height: number;
  alt: string;
}
interface Props {
  eyebrow: string;
  title: string;
  tagline: string;
  image?: ImageProps;
  misty?: boolean;
}
const { eyebrow, title, tagline, image, misty = false } = Astro.props;
const island = misty ? "island-misty" : "island-base";
---

<header class="fhero">
  <a href={withBase("/")} class="fhero__back">&larr; the Dreamland</a>

  <div class="fhero__grid">
    <div class="fhero__text">
      <p class="fhero__eyebrow">{eyebrow}</p>
      <h1 class="fhero__title">{title}</h1>
      <p class="fhero__tagline">{tagline}</p>
    </div>

    <div class="fhero__art">
      {image ? (
        <picture>
          <source srcset={image.webp} type="image/webp" />
          <img
            class="fhero__img"
            src={image.fallback}
            width={image.width}
            height={image.height}
            alt={image.alt}
            loading="eager"
            decoding="async"
          />
        </picture>
      ) : (
        <div class="fhero__unformed" aria-hidden="true"></div>
      )}
      <img
        class="fhero__island"
        src={withBase(`/images/dream/${island}.webp`)}
        alt="" loading="eager" decoding="async"
      />
    </div>
  </div>
</header>

<style>
  .fhero {
    position: relative;
    min-height: min(100svh, 900px);
    display: grid;
    align-content: center;
    padding: var(--space-16) var(--space-4) var(--space-12);
  }

  .fhero__back {
    position: absolute;
    top: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--dur-ui) var(--ease-standard);
  }
  .fhero__back:hover,
  .fhero__back:focus-visible { color: var(--accent-text); }

  .fhero__grid {
    max-width: 68rem;
    margin: 0 auto;
    width: 100%;
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  @media (min-width: 880px) {
    .fhero__grid { grid-template-columns: 1fr 1fr; gap: var(--space-16); }
  }

  .fhero__eyebrow {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin: 0 0 var(--space-3);
  }
  .fhero__title {
    font-size: clamp(2.4rem, 6vw, 4rem);
    line-height: 1.02;
    margin: 0 0 var(--space-4);
    text-wrap: balance;
  }
  .fhero__tagline {
    font-size: var(--text-lg);
    line-height: var(--lh-lg);
    color: var(--text-muted);
    margin: 0;
    max-width: 34ch;
  }

  .fhero__art { position: relative; aspect-ratio: 1 / 1; }
  .fhero__img,
  .fhero__unformed {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 76%;
    height: 76%;
    object-fit: cover;
    -webkit-mask-image: radial-gradient(ellipse 62% 60% at 50% 44%, #000 38%, rgba(0,0,0,.82) 58%, transparent 78%);
    mask-image: radial-gradient(ellipse 62% 60% at 50% 44%, #000 38%, rgba(0,0,0,.82) 58%, transparent 78%);
  }
  .fhero__unformed {
    background: radial-gradient(circle at 50% 45%,
      var(--mint-highlight) 0%, var(--blush-pale) 48%, transparent 74%);
  }
  .fhero__island {
    position: absolute;
    bottom: 4%;
    left: 50%;
    width: 100%;
    max-width: none;
    transform: translateX(-50%);
    pointer-events: none;
  }

  /* the art drifts a little slower than the page — depth inside the field */
  @supports (animation-timeline: scroll()) {
    html.js .fhero__img,
    html.js .fhero__unformed {
      animation: fhero-art linear both;
      animation-timeline: scroll(root);
      animation-range: 0px 900px;
    }
  }
  @keyframes fhero-art {
    from { transform: translateX(-50%) translateY(0); }
    to   { transform: translateX(-50%) translateY(-9%); }
  }
  @media (prefers-reduced-motion: reduce) {
    html.js .fhero__img,
    html.js .fhero__unformed {
      animation: none !important;
      transform: translateX(-50%) !important;
    }
  }
</style>
