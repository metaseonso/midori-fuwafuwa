---
// One dream field, glimpsed on the way down — the production's art resting
// on a painted cloud island. The whole thing is one real <a> to a real
// prerendered URL (no hash routing, no JS navigation).
import { withBase } from "../lib/url";

interface ImageProps {
  webp: string;
  fallback: string;
  width: number;
  height: number;
  alt: string;
}
interface Props {
  index: string;
  title: string;
  line: string;
  href: string;
  image?: ImageProps;
  misty?: boolean;
  flip?: boolean;
}
const { index, title, line, href, image, misty = false, flip = false } = Astro.props;
const island = misty ? "island-misty" : "island-base";
---

<section class:list={["scene", { "scene--flip": flip }]}>
  <a class="vig reveal" href={href}>
    <div class="vig__art">
      {image ? (
        <picture>
          <source srcset={image.webp} type="image/webp" />
          <img
            class="vig__img"
            src={image.fallback}
            width={image.width}
            height={image.height}
            alt={image.alt}
            loading="lazy"
            decoding="async"
          />
        </picture>
      ) : (
        <div class="vig__unformed" aria-hidden="true"></div>
      )}

      <img
        class="vig__island"
        src={withBase(`/images/dream/${island}.webp`)}
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="vig__text">
      <p class="vig__eyebrow">dream field {index}</p>
      <h2 class="vig__title">{title}</h2>
      <p class="vig__line">{line}</p>
      <span class="vig__cta">Step in &rarr;</span>
    </div>
  </a>
</section>

<style>
  .scene {
    min-height: min(96svh, 880px);
    display: grid;
    place-items: center;
    padding: var(--space-12) var(--space-4);
  }

  .vig {
    display: grid;
    gap: var(--space-8);
    align-items: center;
    max-width: 68rem;
    width: 100%;
    text-decoration: none;
    color: var(--text-primary);
  }
  @media (min-width: 880px) {
    .vig { grid-template-columns: 1.05fr 0.95fr; gap: var(--space-16); }
    .scene--flip .vig__art { order: 2; }
  }

  /* ---- the island ----
     The art sits ON the cloud, not behind it: art occupies the upper band,
     the painted cloud sits along the bottom and overlaps only the art's
     lower edge, so the production reads as resting on the island. */
  .vig__art {
    position: relative;
    aspect-ratio: 1 / 1;
  }

  /* The production art dissolves into the sky rather than sitting in a
     frame — feathered mask, no border, no card. */
  .vig__img,
  .vig__unformed {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 74%;
    height: 74%;
    object-fit: cover;
    -webkit-mask-image: radial-gradient(ellipse 62% 60% at 50% 44%, #000 38%, rgba(0,0,0,.82) 58%, transparent 78%);
    mask-image: radial-gradient(ellipse 62% 60% at 50% 44%, #000 38%, rgba(0,0,0,.82) 58%, transparent 78%);
    transition: transform var(--dur-scene) var(--ease-out-soft);
  }
  .vig__unformed {
    background: radial-gradient(circle at 50% 45%,
      var(--mint-highlight) 0%, var(--blush-pale) 48%, transparent 74%);
  }

  /* the painted cloud the art rests on */
  .vig__island {
    position: absolute;
    bottom: 4%;
    left: 50%;
    width: 100%;
    max-width: none;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .vig:hover .vig__img,
  .vig:focus-visible .vig__img,
  .vig:hover .vig__unformed,
  .vig:focus-visible .vig__unformed {
    transform: translateX(-50%) translateY(-4%);
  }

  /* ---- text: no card, it floats on the sky ---- */
  .vig__eyebrow {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin: 0 0 var(--space-3);
  }
  .vig__title {
    font-size: clamp(2rem, 4.5vw, var(--text-4xl));
    line-height: 1.05;
    margin: 0 0 var(--space-4);
    text-wrap: balance;
  }
  .vig__line {
    font-size: var(--text-lg);
    line-height: var(--lh-lg);
    color: var(--text-muted);
    margin: 0 0 var(--space-6);
    max-width: 32ch;
  }
  .vig__cta {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--accent-text);
    display: inline-block;
    transition: transform var(--dur-ui) var(--ease-standard);
  }
  .vig:hover .vig__cta,
  .vig:focus-visible .vig__cta { transform: translateX(6px); }

  .vig:focus-visible {
    outline: 3px solid var(--mint-deep);
    outline-offset: 10px;
    border-radius: var(--radius-xl);
  }

  @media (prefers-reduced-motion: reduce) {
    .vig__img, .vig__unformed { transition: none; }
  }
</style>
