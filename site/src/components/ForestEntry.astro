---
// A sapling (one month) or a grove (one season) — two distinct, visible
// states of the same consolidation cycle. A grove reads as more grown:
// denser, wider, larger icons, a shared clearing behind it.
import Scene from "./Scene.astro";

interface SceneData {
  prose: string;
  mood: string;
  sourceLabel: string;
  sourceHref: string;
  asset: { kind: "sprout" | "leaf" | "bud" | "blossom" | "branch"; alt: string };
}
interface Props {
  type: "sapling" | "grove";
  title: string;
  season: "spring" | "summer" | "autumn" | "winter";
  summary: string;
  scenes: SceneData[];
}
const { type, title, season, summary, scenes } = Astro.props;
---

<section class={`forest-entry forest-entry--${type}`} data-season={season}>
  <header class="forest-entry__header reveal">
    <span class="forest-entry__kind">{type === "grove" ? "Grove" : "Sapling"}</span>
    <h3 class="forest-entry__title">{title}</h3>
    <p class="forest-entry__summary">{summary}</p>
  </header>
  <div class="forest-entry__scenes">
    {scenes.map((scene) => (
      <Scene
        prose={scene.prose}
        mood={scene.mood}
        sourceLabel={scene.sourceLabel}
        sourceHref={scene.sourceHref}
        asset={scene.asset}
      />
    ))}
  </div>
</section>

<style>
  .forest-entry {
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    margin-bottom: var(--space-12);
  }

  .forest-entry__kind {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }
  .forest-entry__title {
    margin: 0 0 var(--space-2);
  }
  .forest-entry__summary {
    color: var(--text-muted);
    max-width: 38rem;
    margin: 0 auto var(--space-6);
  }

  .forest-entry__scenes {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  /* ---- sapling: a single small, young growth ---- */
  .forest-entry--sapling {
    max-width: 30rem;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }
  .forest-entry--sapling .forest-entry__scenes {
    grid-template-columns: 1fr;
  }
  .forest-entry--sapling .scene {
    box-shadow: none;
    background: color-mix(in srgb, var(--ground-warm) 70%, transparent);
  }

  /* ---- grove: fuller, wider, a shared clearing ---- */
  .forest-entry--grove {
    max-width: 56rem;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
    background: color-mix(in srgb, var(--season-ground) 70%, var(--ground));
    box-shadow: var(--shadow-md);
    padding: var(--space-8);
  }
  .forest-entry--grove .forest-entry__title {
    font-size: var(--text-3xl);
  }
  .forest-entry--grove .scene__icon svg {
    width: 56px;
    height: 56px;
  }
  .forest-entry--grove .scene {
    box-shadow: var(--shadow-sm);
  }
</style>
