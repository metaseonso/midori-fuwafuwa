---
// A sapling (one month) or a grove (one season) — two distinct, visible
// states of the same consolidation cycle. A grove reads as more grown:
// denser, wider, larger icons, a shared clearing behind it.
import Scene from "./Scene.astro";

interface SceneData {
  prose: string;
  mood: string;
  sourceLabel: string;
  sourceHref: string;
  asset: { kind: "sprout" | "leaf" | "bud" | "blossom" | "branch"; alt: string };
}
interface Props {
  type: "sapling" | "grove";
  title: string;
  season: "spring" | "summer" | "autumn" | "winter";
  summary: string;
  scenes: SceneData[];
}
const { type, title, season, summary, scenes } = Astro.props;
---

<section class={`forest-entry forest-entry--${type}`} data-season={season}>
  <header class="forest-entry__header reveal">
    <span class="forest-entry__kind">{type === "grove" ? "Grove" : "Sapling"}</span>
    <h3 class="forest-entry__title">{title}</h3>
    <p class="forest-entry__summary">{summary}</p>
  </header>
  <div class="forest-entry__scenes">
    {scenes.map((scene) => (
      <Scene
        prose={scene.prose}
        mood={scene.mood}
        sourceLabel={scene.sourceLabel}
        sourceHref={scene.sourceHref}
        asset={scene.asset}
      />
    ))}
  </div>
</section>

<style>
  .forest-entry {
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    margin-bottom: var(--space-12);
  }

  .forest-entry__kind {
    display: inline-block;
    color: var(--mint-deep);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    margin-bottom: var(--space-3);
  }
  .forest-entry__title {
    margin: 0 0 var(--space-2);
  }
  .forest-entry__summary {
    color: var(--wood);
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.6;
    max-width: 38rem;
    margin: 0 auto var(--space-6);
  }

  .forest-entry__scenes {
    display: grid;
    gap: clamp(var(--space-8), 4vw, var(--space-16));
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  /* offset, never simultaneous: sibling scenes surface 70ms apart on the
     JS-observer reveal path (the view() path staggers naturally by scroll) */
  .forest-entry__scenes > :global(.scene:nth-child(2)) { --reveal-delay: 70ms; }
  .forest-entry__scenes > :global(.scene:nth-child(3)) { --reveal-delay: 140ms; }
  .forest-entry__scenes > :global(.scene:nth-child(4)) { --reveal-delay: 210ms; }
  .forest-entry__scenes > :global(.scene:nth-child(n + 5)) { --reveal-delay: 280ms; }

  /* ---- sapling: a single small, young growth ---- */
  .forest-entry--sapling {
    max-width: 30rem;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }
  .forest-entry--sapling .forest-entry__scenes {
    grid-template-columns: 1fr;
  }
  /* No opacity override here. A sapling reads as young through its size and
     its single column, not by being faded — see DESIGN_SYSTEM §6. */

  /* ---- grove: fuller, wider, a shared clearing ---- */
  /* a grove reads as more grown: wider, denser, and sitting in its own
     pool of warm seasonal light rather than on a panel */
  .forest-entry--grove {
    max-width: 58rem;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
    padding: var(--space-12) var(--space-8);
    background: radial-gradient(ellipse 90% 80% at 50% 50%,
      color-mix(in srgb, var(--season-ground) 92%, white) 0%,
      color-mix(in srgb, var(--season-ground) 55%, transparent) 55%,
      transparent 100%);
  }
  .forest-entry--grove .forest-entry__title {
    font-size: var(--text-3xl);
  }
  .forest-entry--grove .scene__icon svg {
    width: 56px;
    height: 56px;
  }
  /* A grove reads as fuller through width, density and its own pool of
     seasonal light above — never by making its scenes more opaque than a
     sapling's. Both stay readable. */
</style>
