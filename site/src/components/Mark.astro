---
// The arrival mark, and the one thing on this site that performs.
//
// case-study-01's central finding: when a studio has an actual character, the
// site should PERFORM the personality rather than print a paragraph about it.
// The mascot is a cloud at an easel holding a brush. So the mascot paints —
// and what it paints is the air you are standing in.
//
// Move across the arrival and soft painted blooms open where you passed, in
// the mascot's own mint and blush, and dissolve behind you. The mark itself
// leans a little toward you, heavily damped, as though hanging in something
// denser than air. Rest on the mascot and it notices.
//
// Four rules this file must not break:
//
//  1. The logo is used WHOLE. Nothing here dissects it. The drift rides a
//     wrapper so it composes with the scroll-driven lift on the image itself,
//     instead of overwriting that transform.
//  2. transform and opacity only, on every animated thing.
//  3. Reduced motion does not initialise this AT ALL — no listeners, no pool,
//     no rAF. Not "paused": absent. The still mark is the finished design.
//  4. It is decorative. Every word and the mark itself are in the HTML above
//     this behaviour, so a crawler and a no-JS visitor lose nothing.
import { withBase } from "../lib/url";
---

<div class="mark">
  <div class="mark__paint" aria-hidden="true"></div>

  <div class="mark__lean">
    <img
      class="mark__img"
      src={withBase("/images/mark/logo.webp")}
      width="1200"
      height="1200"
      alt="The Midori Fuwafuwa Studio mark: a small mint-green fluffy cloud with rosy cheeks, painting at a wooden easel, beneath its name lettered in an arc."
      fetchpriority="high"
      decoding="async"
    />
  </div>
</div>

<style>
  /* The mark covers the WHOLE arrival, not just the logo's own box. First
     version sized this to the image: the pointer only registered inside a
     620px square, and .mark__paint clipped every brush mark to it. The
     mascot paints the air of the room, so the room is the canvas. */
  .mark {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    isolation: isolate;
  }

  /* The paint sits BEHIND the mark: the mascot stays the subject, and the
     colour reads as something it has put into the air, not over itself. */
  .mark__paint {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .mark__lean {
    position: relative;
    z-index: 1;
    /* `translate` and `rotate`, not `transform` — the pointer lean has to
       compose with the scroll-driven lift, and the individual properties
       apply alongside `transform` rather than replacing it. */
    will-change: translate, rotate;
  }

  .mark__img {
    width: min(86vw, 74vh, 620px);
    height: auto;
    /* The outermost 3% is empty cream margin — the artwork's own bounding box
       starts at 13% on the sides and 5% at the foot. Feathering only that
       margin dissolves any last hairline against the flat page colour without
       touching a pixel of the painting. */
    -webkit-mask-image: radial-gradient(
      closest-side circle at 50% 50%,
      #000 92%,
      transparent 100%
    );
    mask-image: radial-gradient(
      closest-side circle at 50% 50%,
      #000 92%,
      transparent 100%
    );
  }

  /* ---- one brush mark ----
     Built from three offset blobs so an edge is never a clean circle. The
     blur is set once and never animated, so it rasterises a single time and
     the running animation stays transform/opacity only. */
  .mark__paint :global(.bloom) {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--d);
    height: var(--d);
    margin: calc(var(--d) / -2);
    opacity: 0;
    translate: var(--x) var(--y);
    rotate: var(--r);
    pointer-events: none;
    filter: blur(7px);
    background:
      radial-gradient(closest-side ellipse at 38% 42%, var(--c1) 0%, transparent 72%),
      radial-gradient(closest-side ellipse at 66% 61%, var(--c2) 0%, transparent 70%),
      radial-gradient(closest-side ellipse at 52% 38%, var(--c1) 0%, transparent 55%);
  }
  .mark__paint :global(.bloom.is-open) {
    animation: bloom var(--life) var(--ease-out-soft) forwards;
  }
  @keyframes bloom {
    0%   { opacity: 0;   scale: 0.34; }
    18%  { opacity: 1;   }
    62%  { opacity: 0.8; }
    100% { opacity: 0;   scale: 1.3; }
  }

  /* ---- the mascot notices you ----
     --ease-bounce is reserved by DESIGN_SYSTEM §4 for the mascot alone: "the
     overshoot is personality". This is the one place on the site it is used. */
  .mark :global(.mark__lean.is-noticed) {
    animation: notice 900ms var(--ease-bounce);
  }
  @keyframes notice {
    0%   { scale: 1; }
    30%  { scale: 1.035; }
    100% { scale: 1; }
  }

  /* Nothing below initialises under reduced motion — the script returns
     before it builds anything. This is the belt to that braces. */
  @media (prefers-reduced-motion: reduce) {
    .mark__paint { display: none; }
    .mark__lean { translate: none !important; rotate: none !important; animation: none !important; }
  }
</style>

<script>
  // Progressive enhancement, gated three ways: reduced motion, coarse-only
  // pointers with no hover, and the element simply not being there.
  // Every colour is DESIGN_SYSTEM §1. The core is the logo's own cream, which
  // is what makes a mark read at all against a mint ground — mint on mint is
  // invisible, and the fix for that is never to brighten past the palette.
  // §1 colours at full strength, and no cream in them. An earlier version put
  // the logo's cream at the centre of every mark; over the warm glow behind
  // the mascot — which is that same cream — it cancelled to nothing. Paint
  // reads here by being mint or blush against cream, so it is mint or blush.
  const PALETTE = [
    ["rgb(190 236 206 / 0.98)", "rgb(209 239 222 / 0.80)"], // mint · mint-soft
    ["rgb(248 209 209 / 0.96)", "rgb(252 242 244 / 0.78)"], // blush · blush-pale
    ["rgb(190 236 206 / 0.92)", "rgb(248 209 209 / 0.82)"], // mint into blush
    ["rgb(208 177 149 / 0.72)", "rgb(248 209 209 / 0.70)"], // tan · blush
    ["rgb(218 219 206 / 0.85)", "rgb(190 236 206 / 0.75)"], // sage-pale · mint
  ];
  const POOL = 20;
  const SPACING = 46; // px of travel between marks — a brush, not a firehose
  const LEAN = 13; // px, the most the mark ever moves
  const TILT = 1.1; // deg, the most it ever leans
  const EASE = 0.055; // heavily damped: it arrives late, the way it should

  function init(root: HTMLElement) {
    const paint = root.querySelector<HTMLElement>(".mark__paint")!;
    const lean = root.querySelector<HTMLElement>(".mark__lean")!;

    // A fixed pool, reused round-robin. Spawning nodes per pointer event is
    // how a trail like this turns into a memory leak on a long visit.
    const pool: HTMLElement[] = [];
    for (let i = 0; i < POOL; i++) {
      const b = document.createElement("div");
      b.className = "bloom";
      paint.appendChild(b);
      pool.push(b);
    }
    let next = 0;

    let lastX = 0,
      lastY = 0,
      seeded = false;

    function open(x: number, y: number, scale = 1) {
      const b = pool[next];
      next = (next + 1) % POOL;
      const [c1, c2] = PALETTE[(Math.random() * PALETTE.length) | 0];
      const d = (170 + Math.random() * 210) * scale;
      b.style.setProperty("--d", `${d}px`);
      b.style.setProperty("--x", `${x}px`);
      b.style.setProperty("--y", `${y}px`);
      b.style.setProperty("--r", `${Math.random() * 360}deg`);
      b.style.setProperty("--c1", c1);
      b.style.setProperty("--c2", c2);
      b.style.setProperty("--life", `${2800 + Math.random() * 1400}ms`);
      // Restart the animation on a node that may still be mid-flight.
      b.classList.remove("is-open");
      void b.offsetWidth;
      b.classList.add("is-open");
    }

    // ---- the lean: a damped follow, run only while it still has somewhere
    // to go. No permanent rAF loop idling in the background.
    let tx = 0,
      ty = 0,
      cx = 0,
      cy = 0,
      running = false;

    function frame() {
      cx += (tx - cx) * EASE;
      cy += (ty - cy) * EASE;
      lean.style.translate = `${cx * LEAN}px ${cy * LEAN}px`;
      lean.style.rotate = `${cx * TILT}deg`;
      if (Math.abs(tx - cx) > 0.001 || Math.abs(ty - cy) > 0.001) {
        requestAnimationFrame(frame);
      } else {
        running = false;
      }
    }
    function nudge() {
      if (!running) {
        running = true;
        requestAnimationFrame(frame);
      }
    }

    function onMove(e: PointerEvent) {
      const r = root.getBoundingClientRect();
      const px = e.clientX - r.left;
      const py = e.clientY - r.top;

      // Read once, write once — never interleaved, per the GSAP performance
      // rule that applies just as well to hand-written rAF.
      tx = (px / r.width - 0.5) * 2;
      ty = (py / r.height - 0.5) * 2;
      nudge();

      if (!seeded) {
        lastX = px;
        lastY = py;
        seeded = true;
        return;
      }
      const dx = px - lastX;
      const dy = py - lastY;
      if (dx * dx + dy * dy >= SPACING * SPACING) {
        lastX = px;
        lastY = py;
        open(px, py);
      }
    }

    function onLeave() {
      tx = 0;
      ty = 0;
      seeded = false;
      nudge();
    }

    // ---- resting on the mascot, or tapping it: it notices, and paints.
    // Cooled down: pointerenter fires every time the pointer crosses the
    // mark's edge, and without this a wobble on the boundary makes the
    // mascot twitch repeatedly. It should read as noticing you, once.
    let lastDelight = 0;
    function delight(e: PointerEvent) {
      const now = performance.now();
      if (now - lastDelight < 1400) return;
      lastDelight = now;
      const r = root.getBoundingClientRect();
      const px = e.clientX - r.left;
      const py = e.clientY - r.top;
      lean.classList.remove("is-noticed");
      void lean.offsetWidth;
      lean.classList.add("is-noticed");
      for (let i = 0; i < 6; i++) {
        const a = (Math.PI * 2 * i) / 6 + Math.random() * 0.5;
        const rad = 70 + Math.random() * 120;
        open(px + Math.cos(a) * rad, py + Math.sin(a) * rad, 0.85);
      }
    }

    root.addEventListener("pointermove", onMove, { passive: true });
    root.addEventListener("pointerleave", onLeave, { passive: true });
    lean.addEventListener("pointerdown", delight, { passive: true });
    lean.addEventListener("pointerenter", delight, { passive: true });
  }

  const reduce = matchMedia("(prefers-reduced-motion: reduce)");
  const root = document.querySelector<HTMLElement>(".mark");
  // Never initialise under reduced motion: skip the listeners, the pool and
  // the rAF entirely rather than animating into a no-op.
  if (root && !reduce.matches) init(root);
</script>
