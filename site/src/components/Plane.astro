---
// One plane of the arrival's parallax.
//
// Three independent channels of motion, deliberately kept on three different
// CSS properties so they compose on the compositor instead of overwriting one
// another:
//
//   (scroll)   — NOT here. The scroll camera lives on the .rig that wraps
//                each plane in index.astro, so it can scale the plane about
//                the vanishing point. See knowledgebase/craft/the-passage.md.
//   translate  — the cursor camera. The whole scene shifts as the visitor
//                moves, each plane by an amount set by its depth.
//   the img's own translate — ambient float. A slow, endless drift that runs
//                whether or not anyone is doing anything.
//
// The ambient channel is the important one. Before it, every bit of motion on
// this page was welded to the scrollbar: nothing moved unless you dragged it,
// which is what made the page feel mechanical and made a smoothed scroll read
// as lag. A page that breathes on its own does not depend on input to feel
// alive.
//
import { withBase } from "../lib/url";

interface Props {
  src: string;
  /** vw */
  w: number;
  top: string;
  left?: string;
  layer?: "back" | "front";
  flip?: boolean;
  /** How far this plane answers the cursor, in px. Nearer planes move more. */
  depth?: number;
  /** Seconds for one ambient breath. 0 = none. Longer reads heavier. */
  drift?: number;
  /** Trim the plate to the band its art actually occupies:
   *  [aspectRatio, objectPositionY%]. The Y is NOT the art's centre within the
   *  frame — with object-fit: cover that percentage distributes the OVERFLOW,
   *  so it must be solved for. Box width cancels out of that solve, so one
   *  number is correct at every viewport size. Purely a layer-size
   *  optimisation; see the note by .plane--band. */
  band?: [number, number];
}

const {
  src,
  w,
  top,
  left = "50%",
  layer = "back",
  flip = false,
  depth = 10,
  drift = 26,
  band,
} = Astro.props;

const SIZES: Record<string, [number, number]> = {
  "sky-far": [1200, 670],
  "sky-mid": [1200, 670],
  "sky-near": [1200, 670],
  "sky-front": [1200, 670],
  "cloud-floor": [1200, 670],
  "island-base": [1000, 545],
  "island-misty": [900, 491],
  motes: [760, 760],
};
const [iw, ih] = SIZES[src];

// Negative delay starts each plane part-way through its own drift, so they
// never travel in lockstep. Guarded: `x % 0` is NaN, which used to emit
// `--delay: NaNs` on every plane with drift disabled.
const offset = drift > 0 ? -(((drift * 0.37 * (iw % 7)) % drift).toFixed(2)) : 0;
---

<div
  class:list={["plane", `plane--${layer}`, { "plane--band": !!band }]}
  style={`--w:${w}vw; --top:${top}; --left:${left}; --depth:${depth}px;` +
          (band ? ` --band-ar:${band[0]}; --band-y:${band[1]}%;` : "")}
>
  <img
    class:list={["plane__art", { "plane__art--breathes": drift > 0 }]}
    src={withBase(`/images/dream/${src}.webp`)}
    width={iw}
    height={ih}
    alt=""
    aria-hidden="true"
    loading="eager"
    decoding="async"
    style={`--sx:${flip ? -1 : 1}; --drift:${drift}s; --delay:${offset}s;`}
  />
</div>

<style>
  .plane {
    position: absolute;
    top: var(--top);
    left: var(--left);
    width: var(--w);
    pointer-events: none;
    transform: translate(-50%, -50%);
    /* The cursor camera. --pointer-x/y are written once per frame on the
       section by the arrival's pointer loop, so every plane reads the same
       two numbers and only its own depth differs. */
    translate: calc(var(--pointer-x, 0) * var(--depth))
      calc(var(--pointer-y, 0) * var(--depth));
    /* No will-change: a scroll-driven animation already promotes this, and
       pinning a layer for every plane only costs GPU memory. */
  }

  /* Stacking is the rig's job now (index.astro): a rig with a transform is a
     stacking context, so a z-index down here would only order the plane
     inside its own rig. */

  .plane__art {
    width: 100%;
    height: auto;
    max-width: none;
    scale: var(--sx) 1;
  }

  /* Trim a plate to the band its art actually occupies.
     sky-far's painting fills 47% of its frame and sky-mid's 59%; the rest is
     blank alpha the compositor still blends on every scrolled frame. Measured:
     hiding these two plates took scroll jank from 16% of frames over 20ms to
     0, and so did shrinking them to 70% — so the cost was raw layer area, not
     the masks and not the scale.
     Done with object-fit rather than by cropping the files, because
     re-encoding the crop came out five times HEAVIER than the original webp
     and the point is to load less, not more. Same bytes, half the layer. */
  .plane--band .plane__art {
    aspect-ratio: var(--band-ar);
    height: auto;
    object-fit: cover;
    object-position: 50% var(--band-y);
  }
  /* Ambient float is opt-in per plane, and deliberately NOT given to the big
     distant plates. Measured: breathing all four put ~10% of frames over 20ms
     at idle, because the two back plates are ~1.7 megapixels each and a
     forever-running animation recomposites them every single frame. Distant
     cloud should barely move anyway — that is what distance looks like — so
     the near, small planes breathe and the far, huge ones hold. Back to 0%. */
  /* Named plane-drift, not `breathe`: index.astro already had a @keyframes
     breathe for the scroll chevron, Astro does not scope keyframe names, and
     that one won. Every plane was silently running the chevron's bob — which
     also animates opacity to 0.75, so the painted art was being DIMMED, the
     one thing DESIGN_SYSTEM §6 forbids outright. Caught by reading the
     resolved keyframes back off the running animation.

     CONSTANT VELOCITY, not ease-in-out. Measured off hadaka.jp frame by frame:
     its ambient channel is a steady linear drift that wraps, never an
     accelerating-and-decelerating bob. The difference is the whole character of
     the thing — steady travel reads as endless and calm, while ease-in-out
     reads as a loop you can feel repeating.

     `linear` + `alternate` is how you get constant speed out of art that does
     not tile: the velocity never changes, only the direction, and there is no
     seam to jump at. */
  .plane__art--breathes {
    animation: plane-drift var(--drift) linear var(--delay) infinite alternate;
  }
  @keyframes plane-drift {
    from { translate: -1.4% 1.1%; }
    to   { translate: 1.4% -2.4%; }
  }

  @media (max-width: 768px) {
    /* Wider still on a narrow screen: these plates must always overhang the
       viewport or their own straight edges walk into frame. */
    .plane { width: calc(var(--w) * 1.7); }
  }

  @media (prefers-reduced-motion: reduce) {
    /* DESIGN_SYSTEM §4: ambient loops stop entirely. Not slowed — stopped. */
    html.js .plane { translate: none !important; }
      .plane__art { animation: none !important; translate: none !important; }
  }
</style>
