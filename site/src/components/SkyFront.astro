---
// The near cloud bank — the one layer in FRONT of the content, so clouds
// pass over the world as you descend. Depth is occlusion, not just
// differential speed.
//
// Kept to the bottom edge on purpose: rendered full-height it simply
// buried the mascot and the wordmark. It frames the descent from below
// rather than covering it.
import { withBase } from "../lib/url";
---

<div class="front" aria-hidden="true">
  <img
    class="front__bank"
    src={withBase("/images/dream/sky-front.webp")}
    alt=""
    loading="eager"
    decoding="async"
  />
</div>

<style>
  .front {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 4;
  }
  .front__bank {
    position: absolute;
    left: 50%;
    bottom: -30%;
    width: 170vw;
    max-width: none;
    height: auto;
    opacity: 0.5;
    transform: translateX(-50%);
    will-change: transform;
    /* Two jobs. The plate is a rectangle, so its top edge would cut hard
       across the viewport. And drifting at full strength it washed out the
       headings underneath — occlusion should graze the composition, never
       bleach the type. A long fade does both. */
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, rgba(0,0,0,.35) 34%, #000 62%);
    mask-image: linear-gradient(180deg, transparent 0%, rgba(0,0,0,.35) 34%, #000 62%);
  }

  @supports (animation-timeline: scroll()) {
    .front__bank {
      animation: front-drift linear both;
      animation-timeline: scroll(root);
    }
  }
  @keyframes front-drift {
    from { transform: translate(-50%, 14%); }
    to   { transform: translate(-50%, -26%); }
  }

  @media (max-width: 768px) {
    .front__bank { width: 240vw; opacity: 0.45; }
  }

  /* Under reduced motion a static bank just sits on the content, so it goes. */
  @media (prefers-reduced-motion: reduce) {
    .front { display: none; }
  }
</style>
