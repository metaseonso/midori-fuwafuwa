---
// The Dreamland itself — one fixed frame the visitor never leaves.
//
// This is the correction to everything before it. Clouds used to be pinned to
// sections, so a section scrolling away took its sky with it: the room kept
// changing, which is a document going past. This is `position: fixed`. It is
// the room. It never leaves, and the visitor never feels they left the first
// screen.
//
// The horizon effect, which is the part that was missing:
//
// Scaling a cloud up in place makes every cloud arrive in the same spot, one
// on top of the last — a stack. Real distance has a VANISHING POINT. A thing
// far off is tiny AND near the horizon; as it approaches it grows AND travels
// outward from that point, so by the time it reaches you it is off at the edge
// of vision. That divergence is what stops them stacking, and it is why this
// uses `perspective` with `translate3d` on the Z axis rather than `scale`.
// Give a plate a Z and the browser derives its size and its spread from one
// vanishing point, for free and consistently.
//
// Fading at the horizon: DESIGN_SYSTEM §6 says art is never faded to make it
// recede. The founder has asked for exactly that here — "come up as they
// scroll and fade into the background" — so it is deliberate, and confined to
// the far end of the Z travel where it reads as distance, never as a way of
// quieting art that is too strong up close.
import { withBase } from "../lib/url";

// A horizon is two things, and the first version only had the second.
//
// THE BANK — clouds parked far off around the vanishing point. They never
// travel; they only sway. They are the horizon line itself, and they are why
// the sky is never empty. Without them there were stretches of bare mint
// between one traveller fading out and the next fading in.
//
// THE TRAVELLERS — clouds that emerge from the bank, come forward past the
// viewer and are gone. Their scroll windows overlap so several are always in
// flight, and each starts at its own depth so the very first screen already
// has clouds mid-approach rather than everything beginning at the far end.
//
// x/y is the direction each one drifts out toward as it nears. Multiplying
// that offset by Z is what makes them diverge along their own lines instead of
// every cloud arriving up the middle of the screen.
// PERSPECTIVE is the number every size here is measured against. A plate at
// depth z renders at PERSPECTIVE / (PERSPECTIVE + |z|) of its CSS width — so
// at z = -1180 with a 760px perspective, a plate draws at 0.39x. The first
// version sized the bank as though that factor did not exist and the horizon
// came out a fifth of the size it should have been, leaving the sky bare.
// `screen` below is how wide each plate should actually LOOK, in vw, and the
// CSS width is derived from it.
const PERSPECTIVE = 760;
const cssWidth = (screen: number, z: number) =>
  +(screen * ((PERSPECTIVE + Math.abs(z)) / PERSPECTIVE)).toFixed(1);

// ONLY plates that dissolve on all four edges. Measured off each file's alpha
// channel: island-misty and motes are transparent on every edge, island-base
// on three with the fourth at 55/255. sky-far, sky-mid, sky-near, sky-front
// and cloud-floor all end in a hard rectangle on at least two sides.
//
// Everywhere else on this site those wide plates were made safe by running
// them wider than the viewport so their cut edges stayed off screen. That
// trick cannot work here: in a perspective stage a plate's apparent size and
// position change continuously with its depth, so there is no width that
// guarantees overhang. Using them put straight seams across the sky. They are
// excluded outright, and density comes from having more soft plates instead.
// Depth here is chosen for cost as much as for looks. A plate at z = -1180
// must carry 2.6x the CSS width to appear at a given on-screen size, and that
// width is what the browser has to rasterise — nine of those, all swaying,
// measured 9.6% of frames over 20ms at idle and 16.5% mid-descent. Distance
// reads from a thing being SMALL and NEAR THE VANISHING POINT, not from the
// literal z number, so the bank sits shallow and small instead. Same horizon,
// a fraction of the fill.
const BANK = [
  { src: "island-misty", screen: 30, x: -15, y: -7, z: -620, sway: 47 },
  { src: "island-base",  screen: 26, x: 13,  y: -9, z: -700, sway: 59 },
  { src: "island-misty", screen: 22, x: -30, y: 3,  z: -560, sway: 39 },
  { src: "island-base",  screen: 19, x: 29,  y: 6,  z: -660, sway: 43 },
  { src: "island-misty", screen: 24, x: 2,   y: 11, z: -780, sway: 53 },
  { src: "motes",        screen: 14, x: 20,  y: -4, z: -740, sway: 37 },
];

const TRAVEL = [
  { src: "island-misty", w: 26, x: 24,  y: 4,   z0: -520,  from: 0,  to: 34 },
  { src: "island-base",  w: 28, x: -20, y: -11, z0: -900,  from: 0,  to: 48 },
  { src: "island-misty", w: 22, x: -28, y: 9,   z0: -1300, from: 0,  to: 58 },
  { src: "motes",        w: 14, x: 32,  y: -3,  z0: -1500, from: 8,  to: 56 },
  { src: "island-misty", w: 26, x: -12, y: 12,  z0: -1500, from: 20, to: 68 },
  { src: "island-base",  w: 24, x: 20,  y: 8,   z0: -1500, from: 32, to: 80 },
  { src: "island-misty", w: 24, x: -24, y: -9,  z0: -1500, from: 44, to: 92 },
  { src: "motes",        w: 15, x: 10,  y: 14,  z0: -1500, from: 56, to: 100 },
  { src: "island-base",  w: 26, x: 26,  y: -7,  z0: -1500, from: 68, to: 100 },
  { src: "island-misty", w: 24, x: -18, y: 10,  z0: -1500, from: 80, to: 100 },
];

const SIZES: Record<string, [number, number]> = {
  "island-base": [1000, 545],
  "island-misty": [900, 491],
  motes: [760, 760],
};
---

<div class="stage" aria-hidden="true">
  <div class="stage__space">
    {BANK.map((c, i) => {
      const [iw, ih] = SIZES[c.src];
      return (
        <img
          class="hcloud hcloud--bank"
          src={withBase(`/images/dream/${c.src}.webp`)}
          width={iw} height={ih} alt="" loading="eager" decoding="async"
          style={`--w:${cssWidth(c.screen, c.z)}vw; --x:${c.x}vw; --y:${c.y}vh;
                  --z:${c.z}px; --sway:${c.sway}s; --delay:${-(i * 5.3).toFixed(1)}s;`}
        />
      );
    })}

    {TRAVEL.map((c, i) => {
      const [iw, ih] = SIZES[c.src];
      return (
        <img
          class="hcloud hcloud--travel"
          src={withBase(`/images/dream/${c.src}.webp`)}
          width={iw} height={ih} alt=""
          loading={i < 4 ? "eager" : "lazy"} decoding="async"
          style={`--w:${c.w}vw; --x:${c.x}vw; --y:${c.y}vh; --z0:${c.z0}px;
                  --from:${c.from}%; --to:${c.to}%;`}
        />
      );
    })}
  </div>
</div>

<style>
  .stage {
    position: fixed;
    inset: 0;
    /* The ground lives here, not on <main>. It used to be a background on the
       scrolling content, which is a positioned element later in the document —
       so it painted straight over this fixed stage and hid all 25 clouds
       completely. The sky is the backdrop; the content is transparent and sits
       on top of it. */
    background: linear-gradient(
      180deg,
      #c9edda 0%,
      #d0efdf 12%,
      #d8f0e2 30%,
      #e3f1e4 52%,
      #ecf0e2 74%,
      #f2eede 90%,
      #f4edd6 100%
    );
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    /* The vanishing point. Everything's size and spread is derived from it, so
       there is exactly one horizon and nothing has to agree with it by hand. */
    perspective: 760px;
    perspective-origin: 50% 46%;
  }
  .stage__space {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  .hcloud {
    position: absolute;
    left: 50%;
    top: 46%;
    width: var(--w);
    max-width: none;
    height: auto;
  }

  /* The bank: parked at the horizon, never travelling, only swaying. Constant
     velocity — steady travel reads as endless, an eased bob reads as a loop. */
  .hcloud--bank {
    transform: translate(-50%, -50%) translate3d(var(--x), var(--y), var(--z));
    animation: bank-sway var(--sway) linear var(--delay) infinite alternate;
  }
  @keyframes bank-sway {
    from { translate: -2.5% 1.5%; }
    to   { translate: 2.5% -2%; }
  }

  /* The travellers, at rest: parked mid-distance so a no-JS page and any
     browser without scroll timelines still shows a layered sky. */
  .hcloud--travel {
    transform: translate(-50%, -50%) translate3d(var(--x), var(--y), -560px);
  }

  @supports (animation-timeline: scroll()) {
    html.js .hcloud--travel {
      animation: horizon linear both;
      animation-timeline: scroll(root);
      animation-range: var(--from) var(--to);
    }
  }

  /* Out of the vanishing point, forward, and past. The x/y offset grows with
     Z, which is what makes each one diverge on its own line instead of every
     cloud arriving up the middle. */
  @keyframes horizon {
    0% {
      transform: translate(-50%, -50%)
        translate3d(calc(var(--x) * 0.14), calc(var(--y) * 0.14), var(--z0));
      opacity: 0;
    }
    12% { opacity: 1; }
    74% { opacity: 1; }
    100% {
      transform: translate(-50%, -50%)
        translate3d(calc(var(--x) * 2.1), calc(var(--y) * 2.1), 380px);
      opacity: 0;
    }
  }

  @media (max-width: 860px) {
    .stage { perspective: 560px; }
    .hcloud { width: calc(var(--w) * 1.8); }
  }

  @media (prefers-reduced-motion: reduce) {
    /* The still frame is the primary design: a quiet, layered sky, parked. */
    html.js .hcloud {
      animation: none !important;
      translate: none !important;
    }
    html.js .hcloud--travel {
      transform: translate(-50%, -50%)
        translate3d(var(--x), var(--y), -560px) !important;
    }
  }
</style>
