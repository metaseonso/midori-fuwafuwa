---
// One dream field. The shell for all three, deliberately.
//
// The three field pages used to carry their own copy of this markup and a
// duplicated <style> block each. They drifted from the landing and from each
// other. Now the shell lives here and a page supplies only what is actually
// its own: its name, its art, its prose, its recaps.
//
// Rules inherited from the landing, and not to be relaxed here:
//   - Art is never dimmed. The round bleed is an EDGE treatment; the subject
//     holds full opacity. Too strong means resize or move, never fade.
//   - Depth comes from cloud banks passing in front of and behind things.
//   - Running text sits on .textsurface, never bare on painted cloud.
import Layout from "./Layout.astro";
import Drift from "../components/Drift.astro";
import ForestEntry from "../components/ForestEntry.astro";
import { withBase } from "../lib/url";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  name: string;
  tagline: string;
  image?: { webp: string; width: number; height: number; alt: string };
  recaps: any[];
}

const { title, description, eyebrow, name, tagline, image, recaps } = Astro.props;
---

<Layout title={title} description={description}>
  <main id="main" class="field dreamground">
    {/* Cloud banks, full opacity. Placed down the outer edges so they graze
        the composition and never pass behind a line of running text. */}
    <Drift src="island-base"  w={46}  top="10%" left="93%" drift={22} layer="front" />
    <Drift src="motes"        w={20}  top="22%" left="7%"  drift={28} layer="back" />
    <Drift src="island-misty" w={40}  top="41%" left="-4%" drift={24} layer="front" flip />
    <Drift src="island-base"  w={50}  top="62%" left="101%" drift={14} layer="back" flip />
    <Drift src="motes"        w={24}  top="80%" left="9%"  drift={30} layer="front" />
    <Drift src="island-misty" w={36}  top="93%" left="97%" drift={26} layer="back" />

    <p class="field__back">
      <a href={withBase("/")}>&larr; the Dreamland</a>
    </p>

    <header class="fhero">
      <div class="fhero__word">
        <p class="fhero__eyebrow">{eyebrow}</p>
        <h1 class="fhero__title">{name}</h1>
        <p class="fhero__tagline">{tagline}</p>
      </div>

      <figure class="fhero__art">
        {image ? (
          <img
            class="fhero__img"
            src={image.webp}
            width={image.width}
            height={image.height}
            alt={image.alt}
            fetchpriority="high"
            decoding="async"
          />
        ) : (
          /* A field with no art yet gets a deliberate absence, not a borrowed
             cloud. The first version reused island-misty here — the same plate
             the atmosphere is made of — so the art column just read as empty
             sky. This is a shape: mint and blush at full strength, edgeless,
             clearly waiting for something. role/aria-label because a div has
             no alt, and the alt IS the artwork to every AI crawler. */
          <div
            class="fhero__unformed"
            role="img"
            aria-label="No art yet — a soft bloom of mint and blush light where this field's painting will go."
          ></div>
        )}
      </figure>
    </header>

    <section class="field__body">
      <slot />
    </section>

    <section class="forest" id="forest" aria-label="The forest within">
      <div class="forest__head">
        <h2 class="forest__title">The forest within</h2>
        <p class="forest__intro">
          A sapling per monthly consolidation. A fuller grove per season.
        </p>
      </div>

      {recaps.length === 0 ? (
        <p class="forest__empty">
          No saplings yet. The first one is still taking root.
        </p>
      ) : (
        <div class="forest__entries">
          {recaps.map((entry) => <ForestEntry {...entry.data} />)}
        </div>
      )}
    </section>
  </main>
</Layout>

<style>
  .field { padding-bottom: clamp(var(--space-24), 14vh, 180px); }

  /* ---- back to the hub ---- */
  .field__back {
    position: relative;
    z-index: 5;
    margin: 0;
    padding: var(--space-8) var(--space-8) 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
  }
  .field__back a {
    color: var(--mint-deep);
    text-decoration: none;
    transition: color var(--dur-ui) var(--ease-standard);
  }
  .field__back a:hover { color: var(--ink); }

  /* ---- the opening ----
     Same grid, type scale and bleed as a World block on the landing, so
     arriving here reads as going deeper rather than going elsewhere. */
  .fhero {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(var(--space-8), 5vw, var(--space-24));
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(var(--space-12), 9vh, var(--space-24)) var(--space-6);
  }

  .fhero__word { position: relative; z-index: 4; }

  .fhero__eyebrow {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--mint-deep);
    margin: 0 0 var(--space-4);
  }
  .fhero__title {
    font-size: clamp(2.8rem, 7vw, 5rem);
    line-height: 1.0;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 var(--space-6);
    text-wrap: balance;
  }
  .fhero__tagline {
    font-size: clamp(1.0625rem, 1.5vw, 1.35rem);
    line-height: 1.62;
    color: var(--wood);
    max-width: 32ch;
    margin: 0;
  }

  /* ---- the frame ----
     The art now drifts INSIDE a window instead of moving as one block: the
     frame travels at page speed, the painting inside it lags. That is the
     whole "premium parallax" effect, and it is what gives each world depth of
     its own rather than depth only against its neighbours.

     Two things make it safe here. The clip and the soft bleed both live on
     the FRAME — clipping with a plain `overflow: hidden` alone would hand
     back the hard rectangle this whole site exists to avoid. And the
     oversize rides `scale`, not width/height, because global.css sets
     `img[width][height] { height: auto }` at a higher specificity than any
     class here could reach, and because scale composes with translate on the
     compositor instead of fighting it. */
  .fhero__art {
    margin: 0;
    position: relative;
    z-index: 2;
    overflow: hidden;
    view-timeline-name: --frame;
    -webkit-mask-image: radial-gradient(
      closest-side circle at 50% 50%,
      #000 54%,
      rgba(0, 0, 0, 0.86) 72%,
      rgba(0, 0, 0, 0.4) 88%,
      transparent 100%
    );
    mask-image: radial-gradient(
      closest-side circle at 50% 50%,
      #000 54%,
      rgba(0, 0, 0, 0.86) 72%,
      rgba(0, 0, 0, 0.4) 88%,
      transparent 100%
    );
  }
  .fhero__img {
    width: 100%;
    height: auto;
    scale: 1.14;
    will-change: translate;
  }

  .fhero__unformed {
    aspect-ratio: 1;
    width: 100%;
    background:
      radial-gradient(circle at 44% 40%, rgb(248 209 209 / 0.85) 0%, rgb(248 209 209 / 0) 46%),
      radial-gradient(circle at 58% 56%, rgb(190 236 206 / 0.95) 0%, rgb(190 236 206 / 0) 52%),
      radial-gradient(circle at 50% 50%, rgb(209 239 222 / 0.8) 0%, rgb(209 239 222 / 0) 68%);
  }

  /* ---- the prose ---- */
  .field__body {
    position: relative;
    z-index: 4;
    max-width: 38rem;
    margin: clamp(var(--space-16), 12vh, var(--space-32)) auto 0;
    padding: 0 var(--space-6);
    font-size: clamp(1.0625rem, 1.35vw, 1.25rem);
    line-height: 1.68;
    color: var(--ink);
  }
  /* Slotted content carries the PAGE's scope, not this component's, so these
     have to escape scoping to reach the prose each field passes in. */
  .field__body :global(p) { margin: 0 0 var(--space-6); }
  .field__body :global(p:last-child) { margin-bottom: 0; }

  /* ---- the forest ---- */
  .forest {
    position: relative;
    z-index: 4;
    max-width: 64rem;
    margin: clamp(var(--space-24), 18vh, 200px) auto 0;
    padding: 0 var(--space-6);
    text-align: center;
  }
  .forest__head { max-width: 34rem; margin: 0 auto clamp(var(--space-16), 9vh, var(--space-24)); }
  .forest__title {
    font-size: clamp(2rem, 4.4vw, 3.1rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0 0 var(--space-4);
  }
  .forest__intro {
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: 1.6;
    color: var(--wood);
    margin: 0;
  }
  .forest__empty {
    max-width: 26rem;
    margin: 0 auto;
    color: var(--wood);
  }

  /* ---- the opening settles as it arrives ----
     Inside @supports only: a browser without scroll-driven animation never
     sets opacity: 0 here, so it shows the finished page. Nothing can get
     stuck invisible, and a non-scrolling crawler reads it all. */
  @supports (animation-timeline: view()) {
    html.js .fhero__art {
      animation: fhero-settle linear both;
      animation-timeline: --frame;
      animation-range: entry 2% cover 26%;
    }
    html.js .fhero__word {
      animation: fword-settle linear both;
      animation-timeline: view();
      animation-range: entry 10% cover 30%;
    }
    /* A named timeline, not an anonymous view(). The frame carries
       `overflow: hidden`, which makes it a scroll container — so an
       anonymous view() declared on anything INSIDE it resolves against the
       frame rather than the page, sits at constant progress and never
       moves. Naming the timeline on the frame itself, where the scrollport
       really is the page, is what makes the inner drift work at all. */
    html.js .fhero__img {
      animation: fhero-in-frame linear both;
      animation-timeline: --frame;
      animation-range: cover;
    }
  }
  @keyframes fhero-settle {
    from { opacity: 0; transform: translateY(64px) scale(0.974); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes fhero-in-frame {
    from { translate: 0 -5%; }
    to   { translate: 0 5%; }
  }
  @keyframes fword-settle {
    from { opacity: 0; transform: translateY(42px); }
    to   { opacity: 1; transform: none; }
  }

  @media (max-width: 860px) {
    .fhero {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
      max-width: 34rem;
    }
    /* Art first on a narrow screen: the painting is the invitation. */
    .fhero__art { order: -1; }
    .field__back { padding: var(--space-6) var(--space-6) 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    html.js .fhero__art,
    html.js .fhero__word,
    html.js .fhero__img {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
      translate: none !important;
    }
    html.js .fhero__img { scale: 1.14 !important; }
  }
</style>
