---
import { getCollection } from "astro:content";
import Field from "../../layouts/Field.astro";
import { sortForestEntries } from "../../lib/forestSort";

// Copy is the founders' own, trimmed: productions/couple-app/PROJECT.md.
//
// This page used to be titled "A dream still taking shape". That is composed
// atmospheric prose, and it did not match the name the landing links with —
// so the field is called what the landing calls it. The status lines below
// are facts from the brief ("No reference image yet. No name yet."), not mood.
const recaps = sortForestEntries(
  await getCollection("recaps", ({ id }) => id.startsWith("couple-app/"))
);
---

<Field
  title="Couple App — a dream field | Midori Fuwafuwa™"
  description="A couple app. Very us (Midori Fuwa Fuwa). Midori Fuwafuwa's third dream field — no name yet, no art yet."
  eyebrow="Dream field 03"
  name="Couple App"
  tagline="Very us (Midori Fuwa Fuwa)."
  recaps={recaps}
>
  <p class="reveal">A couple app. Very us (Midori Fuwa Fuwa).</p>
  <p class="reveal" style="--reveal-delay: 120ms;">No name yet. No art yet.</p>
</Field>
