---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import FieldHero from "../../components/FieldHero.astro";
import ForestEntry from "../../components/ForestEntry.astro";
import { sortForestEntries } from "../../lib/forestSort";

const recaps = sortForestEntries(
  await getCollection("recaps", ({ id }) => id.startsWith("couple-app/"))
);
---

<Layout
  title="A dream still taking shape — a dream field | Midori Fuwafuwa™"
  description="A couple app. Very us (Midori Fuwa Fuwa) — rooted in Seonso and Grumpy Carrot's own relationship. No name yet, no art yet."
>
  <main id="main">
    <FieldHero
      eyebrow="Dream field 03 · unnamed"
      title="A dream still taking shape"
      tagline="Very us (Midori Fuwa Fuwa)."
      accent="--sage-pale"
      misty
    />

    <section class="field-body">
      <p class="reveal">
        A couple app. Very us (Midori Fuwa Fuwa) — rooted in Seonso and Grumpy Carrot's own
        relationship. No name yet. No art yet.
      </p>
    </section>

    <section class="field-forest" id="forest" aria-label="The forest within">
      <h2 class="reveal">The forest within</h2>
      <p class="reveal field-forest__intro">
        A sapling per monthly consolidation. A fuller grove per season.
      </p>
      {recaps.length === 0 ? (
        <p class="reveal field-forest__empty">No saplings yet. The first one is still taking root.</p>
      ) : (
        <div class="field-forest__entries">
          {recaps.map((entry) => <ForestEntry {...entry.data} />)}
        </div>
      )}
    </section>
  </main>
</Layout>

<style>
  .field-body {
    max-width: 42rem;
    margin: 0 auto;
    padding: var(--space-24) var(--space-4);
    font-size: var(--text-lg);
    line-height: var(--lh-lg);
  }
  .field-forest {
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 var(--space-4) var(--space-32);
    text-align: center;
  }
  .field-forest h2 {
    font-size: var(--text-3xl);
  }
  .field-forest__intro {
    color: var(--text-muted);
    margin-bottom: var(--space-8);
  }
  .field-forest__empty {
    font-style: italic;
    color: var(--text-muted);
  }
</style>
