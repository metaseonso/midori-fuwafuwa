---
import { getCollection } from "astro:content";
import Field from "../../layouts/Field.astro";
import { sortForestEntries } from "../../lib/forestSort";
import { withBase } from "../../lib/url";

// Copy is the founders' own, trimmed: productions/the-kits/PROJECT.md.
const recaps = sortForestEntries(
  await getCollection("recaps", ({ id }) => id.startsWith("the-kits/"))
);
---

<Field
  title="The Kits — a dream field | Midori Fuwafuwa™"
  description="Seonso and Grumpy Carrot's children, on their journey exploring and learning about the many worlds around us. Midori Fuwafuwa's first production."
  eyebrow="Dream field 01"
  name="The Kits"
  tagline="Seonso and Grumpy Carrot's children, on their journey exploring and learning about the many worlds around us."
  recaps={recaps}
  image={{
    webp: withBase("/images/fields/the-kits-reference.webp"),
    width: 640,
    height: 640,
    alt: "Direction reference for The Kits: a fox-sage father in a deep blue hanbok and a fox mother in a pink floral hanbok, leading four fox-eared children — one carrying a scroll, one an infant in a basket carrier — through a lantern-lit forest with fireflies and butterflies.",
  }}
>
  <p class="reveal">
    &ldquo;Kits&rdquo; carries both meanings at once &mdash; fox kits, and kids. The
    wordplay is load-bearing: it ties the family&rsquo;s fox nature to the children at
    the centre of the story.
  </p>
  <p class="reveal" style="--reveal-delay: 120ms;">
    An original IP, planned to start as a children&rsquo;s book series. A family group
    of six &mdash; two parents, four children &mdash; all fox-eared. Soft watercolour
    storybook illustration. Hanging lanterns, fireflies, butterflies, dappled light
    through a heavy canopy.
  </p>
</Field>
