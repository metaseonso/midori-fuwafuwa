---
import { getCollection } from "astro:content";
import Field from "../../layouts/Field.astro";
import { sortForestEntries } from "../../lib/forestSort";
import { withBase } from "../../lib/url";

// Copy is the founders' own, trimmed: productions/whimsy-fairy-journal/PROJECT.md.
// The quote below is Whimsy's voice and belongs here — and only here. See
// knowledgebase/decisions/decision-log.md, 2026-08-19.
const recaps = sortForestEntries(
  await getCollection("recaps", ({ id }) => id.startsWith("whimsy-fairy-journal/"))
);
---

<Field
  title="Whimsy — a dream field | Midori Fuwafuwa™"
  description="A magical fairy keeps your journals, notes and doodles safe, then sprinkles fairy dust to turn them into a whimsical world you can explore."
  eyebrow="Dream field 02"
  name="Whimsy"
  tagline="A magical fairy keeps your journals, notes and doodles safe — then sprinkles fairy dust to turn them into a whimsical world you can explore."
  recaps={recaps}
  image={{
    webp: withBase("/images/fields/whimsy-reference.webp"),
    width: 640,
    height: 640,
    alt: "Direction reference for Whimsy: a small fairy with lilac hair and iridescent wings hovers over an open journal, from whose pages floating islands rise, each carrying a tiny gazebo and trailing gold sparkle dust.",
  }}
>
  <p class="reveal">
    A magical fairy keeps your diary entries, journal pages, daily planner agendas,
    scrapbooks, pinboards, notes, and doodles safe &mdash; then sprinkles fairy dust
    to turn them into a whimsical world you can explore. Mundane tasks, to-do lists,
    random ideas, and doodles come alive with vivid images and charming animations.
    As the seasons change, you receive personalised recaps of your own storyline,
    woven together with fascinating facts ranging from the earth to the stars and
    everything in between.
  </p>

  <blockquote class="whimsy-quote reveal" style="--reveal-delay: 120ms;">
    <p>
      They say not to get lost in your fantasies, but we know you&rsquo;re a secret
      genius with a method to your madness.
    </p>
    <p>
      So we say: don&rsquo;t get lost in your fantasies &mdash;
      let&rsquo;s <em>find</em> ourselves <em>through</em> them!
    </p>
    <p>With just a bit of <strong>whimsy</strong>.</p>
  </blockquote>
</Field>

<style>
  /* Whimsy's own voice, set apart from the description above it. Baloo 2 and
     a mint rule — the studio never raises its voice, so this does not shout
     either; it just stops being the same speaker. */
  .whimsy-quote {
    margin: var(--space-12) 0 0;
    padding-left: clamp(var(--space-4), 3vw, var(--space-8));
    border-left: 3px solid var(--mint);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.15rem, 1.7vw, 1.5rem);
    line-height: 1.5;
    color: var(--ink-green);
  }
  .whimsy-quote p { margin: 0 0 var(--space-4); }
  .whimsy-quote p:last-child { margin-bottom: 0; }
  .whimsy-quote em { font-style: normal; font-weight: 700; color: var(--ink); }
  .whimsy-quote strong { font-weight: 700; }
</style>
