---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import FieldHero from "../../components/FieldHero.astro";
import ForestEntry from "../../components/ForestEntry.astro";
import { sortForestEntries } from "../../lib/forestSort";
import { withBase } from "../../lib/url";

const recaps = sortForestEntries(
  await getCollection("recaps", ({ id }) => id.startsWith("whimsy-fairy-journal/"))
);
---

<Layout
  title="Whimsy — a dream field | Midori Fuwafuwa™"
  description="A fairy keeps your journals, notes, and doodles safe, then sprinkles fairy dust to turn them into a world you can explore."
>
  <main id="main">
    <FieldHero
      eyebrow="Dream field 02 · working title"
      title="Whimsy"
      tagline="A fairy keeps your journals, notes, and doodles safe, then sprinkles fairy dust to turn them into a whimsical world you can explore."
      accent="--blush"
      image={{
        avif: withBase("/images/fields/whimsy-reference.avif"),
        webp: withBase("/images/fields/whimsy-reference.webp"),
        fallback: withBase("/images/fields/whimsy-reference.jpg"),
        width: 640,
        height: 640,
        alt: "Direction reference for Whimsy: a small fairy with lilac hair and iridescent wings hovers over an open journal, from whose pages floating islands rise, each carrying a tiny gazebo and trailing gold sparkle dust.",
      }}
    />

    <section class="field-body">
      <p class="reveal">
        A magical fairy keeps your diary entries, journal pages, daily planner agendas,
        scrapbooks, pinboards, notes, and doodles safe — then sprinkles fairy dust to turn them
        into a whimsical world you can explore. Mundane tasks, to-do lists, random ideas, and
        doodles come alive with vivid images and charming animations. As the seasons change,
        you receive personalised recaps of your own storyline, woven together with fascinating
        facts ranging from the earth to the stars and everything in between.
      </p>
      <blockquote class="reveal field-body__quote">
        <p>
          They say not to get lost in your fantasies, but we know you're a secret genius with
          a method to your madness.
        </p>
        <p>So we say: don't get lost in your fantasies — let's FIND ourselves THROUGH them!</p>
        <p>With just a bit of <strong>WHIMSY</strong>.</p>
      </blockquote>
    </section>

    <section class="field-forest" id="forest" aria-label="The forest within">
      <h2 class="reveal">The forest within</h2>
      <p class="reveal field-forest__intro">
        A sapling per monthly consolidation. A fuller grove per season.
      </p>
      {recaps.length === 0 ? (
        <p class="reveal field-forest__empty">No saplings yet. The first one is still taking root.</p>
      ) : (
        <div class="field-forest__entries">
          {recaps.map((entry) => <ForestEntry {...entry.data} />)}
        </div>
      )}
    </section>
  </main>
</Layout>

<style>
  .field-body {
    max-width: 42rem;
    margin: 0 auto;
    padding: var(--space-24) var(--space-4);
    font-size: var(--text-lg);
    line-height: var(--lh-lg);
  }
  .field-body__quote {
    margin: var(--space-8) 0;
    padding: var(--space-6) var(--space-8);
    background: color-mix(in srgb, var(--blush-pale) 60%, var(--ground));
    border-left: 4px solid var(--blush);
    border-radius: var(--radius-lg);
    font-family: var(--font-hand);
    font-size: var(--text-xl);
    line-height: 1.4;
  }
  .field-body__quote p {
    margin: 0 0 var(--space-2);
  }
  .field-body__quote p:last-child {
    margin-bottom: 0;
  }
  .field-forest {
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 var(--space-4) var(--space-32);
    text-align: center;
  }
  .field-forest h2 {
    font-size: var(--text-3xl);
  }
  .field-forest__intro {
    color: var(--text-muted);
    margin-bottom: var(--space-8);
  }
  .field-forest__empty {
    font-style: italic;
    color: var(--text-muted);
  }
</style>
