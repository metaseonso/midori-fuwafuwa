---
import Layout from "../layouts/Layout.astro";

import Mark from "../components/Mark.astro";
import Plane from "../components/Plane.astro";

import { withBase } from "../lib/url";

// Every word on this page is the founders' own, trimmed and never rewritten.
// Sources: ETHOS.md §"The studio" and §"What we make things for",
// PROJECT.md §"dream fields", productions/*/PROJECT.md (one line each).
// Nothing here is composed.
//
// Boundary (founder, 2026-08-19): "don't get lost in your fantasies — let's
// find ourselves through them" is WHIMSY's voice, not the studio's. It stays
// on the Whimsy field page, where it already sits with its full framing. Do
// not promote a production's line to studio level, however strong it reads.
---

<Layout
  title="Midori Fuwafuwa™ — a production studio based out of a Dreamland"
  description="A production studio based out of a Dreamland, shared by Seonso and Grumpy Carrot. Midori Fuwa Fuwa, and the different dream fields inside it."
>
  <main id="main" class="dream dreamground">
    <!-- ── arrival ────────────────────────────────────────────────────
         The mark, whole and uncropped, on its own cream. The logo's
         ground is #F4EDD6 (measured off the file's border), so the page
         is that colour and the image needs no cutout at all. -->
    <div class="frame">
    <section class="arrival viewport-cap">
      <h1 class="visually-hidden">Midori Fuwafuwa Studio</h1>

      {/* Layered planes, bottom-heavy, so the arrival reads as a cloudscape
          with a floor rather than a gradient with decoration on it. Speeds
          are the reference's own scale: 100% is page speed, lower is further
          away. Front planes are kept low, where they graze past the mascot
          without ever crossing its face.

          Which plate can go where is not a taste call — it was measured off
          the alpha channel of each file:
            sky-far, sky-mid  dissolve top and bottom, hard left/right
                              → run wider than the viewport, edges off screen
            cloud-floor       dissolves at the top only
                              → pinned low, its sides and foot off screen
            island-misty      dissolves on all four edges → free to sit anywhere
            sky-near, sky-front  hard rectangles on ALL four edges, and
                              sky-near carries a straight cut inside the art
                              itself → unusable here at any size. The first
                              version used sky-near and put a hard horizontal
                              seam across the top of the hero.
          Nothing is faded to hide an edge — DESIGN_SYSTEM §6. */}
      <Plane src="sky-far"      w={118} top="10%" left="46%" layer="back"  depth={7}  drift={0}  partY="-78vh" partScale={1.25} />
      <Plane src="sky-mid"      w={126} top="46%" left="56%" layer="back"  depth={13} drift={0}  partY="82vh"  partScale={1.3} flip />
      <Plane src="island-base"  w={40}  top="76%" left="89%" layer="front" depth={30} drift={21} partX="52vw"  partY="16vh" partScale={1.5} flip />
      <Plane src="island-misty" w={44}  top="86%" left="12%" layer="front" depth={38} drift={17} partX="-54vw" partY="22vh" partScale={1.5} />

      <Mark />

      {/* Revealed inside the frame as the cloud draws off it. Reveal-on-scroll
          is the architecture, by the founder's decision.

          The guard that makes it acceptable is the one this project's own
          crawlers-and-parallax.md prescribes: nothing is hidden except behind
          `html.js`. With no JS these are a plain readable column under the
          mark — and no AI crawler runs JS at all, so GPTBot, ClaudeBot,
          PerplexityBot and the rest read the full page and every alt text.
          Googlebot does render JS and will see the closed state; that document
          calls this a risk zone rather than a violation and prescribes
          checking it in URL Inspection before launch. Worth doing. */}
      <div class="glimpses">
        <a class="glimpse glimpse--01" href={withBase("/fields/the-kits/")}>
          <img
            class="glimpse__art"
            src={withBase("/images/fields/the-kits-reference.webp")}
            width="640" height="640"
            alt="The Kits: a fox father in deep blue hanbok and a fox mother in floral pink, with four ginger fox-eared children, walking a lantern-lit forest path."
            loading="lazy" decoding="async"
          />
          <span class="glimpse__word">
            <span class="glimpse__index">01</span>
            <span class="glimpse__name">The Kits</span>
            <span class="glimpse__line">Seonso and Grumpy Carrot&rsquo;s children, on their journey exploring and learning about the many worlds around us.</span>
          </span>
        </a>

        <a class="glimpse glimpse--02" href={withBase("/fields/whimsy/")}>
          <img
            class="glimpse__art"
            src={withBase("/images/fields/whimsy-reference.webp")}
            width="640" height="640"
            alt="Whimsy: a lilac-haired fairy with iridescent wings hovering above an open journal, small green islands rising out of its written pages in a trail of gold sparkles."
            loading="lazy" decoding="async"
          />
          <span class="glimpse__word">
            <span class="glimpse__index">02</span>
            <span class="glimpse__name">Whimsy</span>
            <span class="glimpse__line">A magical fairy keeps your journal pages, notes and doodles safe &mdash; then sprinkles fairy dust to turn them into a world you can explore.</span>
          </span>
        </a>

        <a class="glimpse glimpse--03" href={withBase("/fields/couple-app/")}>
          <span
            class="glimpse__art glimpse__art--unformed"
            role="img"
            aria-label="No art yet — a bloom of mint and blush light where this field's painting will go."
          ></span>
          <span class="glimpse__word">
            <span class="glimpse__index">03</span>
            <span class="glimpse__name">Couple App</span>
            <span class="glimpse__line">Very us (Midori Fuwa Fuwa). No name yet. No art yet.</span>
          </span>
        </a>
      </div>

      <p class="arrival__cue" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 26 26" fill="none">
          <path
            d="M6 10.5l7 6.5 7-6.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </p>
    </section>


    </div>
  </main>
</Layout>

<style>
  /* Ground, --paper and the body colour now live in global.css as
     .dreamground — one definition shared with every dream field, so the
     landing and the fields can never drift apart again. */
  .dream { position: relative; }

  /* ── arrival ─────────────────────────────────────────────────────── */
  .arrival {
    display: grid;
    place-items: center;
    position: relative;
    padding: var(--space-12) var(--space-6) var(--space-24);
    isolation: isolate;
    /* No overflow clip, deliberately. Clipping the section drew a razor-
       straight line across the full width where the cloudscape met the next
       section — a hard rectangle, which is the one thing this design cannot
       have. So nothing is clipped; instead every plane here is one whose
       alpha dissolves at top and bottom, and it is simply allowed to carry
       on past the fold. `isolation: isolate` keeps them all inside this
       section's stacking context, so the copy below still paints over them.

       The cap from .viewport-cap, named so the planes can measure their
       travel against the section's real height (reference, point 4). */
    --range: min(100svh, 900px);
  }
  /* Warm light behind the mark. It reaches far past the logo's own edge and
     dissolves long before it stops, so the mark's cream ground and the page
     never meet at a line. */
  .arrival::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(132vw, 1040px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      closest-side circle,
      var(--paper) 0 30%,
      rgba(244, 237, 214, 0.9) 46%,
      rgba(244, 237, 214, 0.5) 68%,
      rgba(244, 237, 214, 0) 100%
    );
    z-index: -1;
    pointer-events: none;
  }

  .arrival__cue {
    position: absolute;
    z-index: 2;
    bottom: var(--space-12);
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    color: var(--sage);
  }

  /* Weightless, and a little late: the mark hangs before it lifts away. */
  @supports (animation-timeline: scroll()) {
    html.js .arrival :global(.mark__img) {
      animation: mark-away linear both;
      animation-timeline: scroll(root);
      /* On the same clock as the cloud, and finished before the first project
         arrives. At 78vh of a 430vh scroll the mark was still a fifth visible
         when The Kits came in, so STUDIO sat on top of the title. */
      animation-range: 0% 8%;
    }
    html.js .arrival__cue {
      animation: cue-away linear both;
      animation-timeline: scroll(root);
      animation-range: 0% 3%;
    }
  }
  @keyframes mark-away {
    0%   { transform: translateY(0) scale(1); opacity: 1; }
    38%  { transform: translateY(-8px) scale(1.005); opacity: 1; }
    100% { transform: translateY(-84px) scale(0.955); opacity: 0; }
  }
  @keyframes cue-away {
    to { opacity: 0; transform: translateX(-50%) translateY(10px); }
  }

  html.js .arrival__cue svg { animation: cue-breathe 3.4s var(--ease-standard) infinite; }
  @keyframes cue-breathe {
    0%, 100% { transform: translateY(0); opacity: 0.75; }
    50%      { transform: translateY(6px); opacity: 1; }
  }

  /* ── the frame ───────────────────────────────────────────────────
     The arrival is the whole experience. It does not scroll away: it pins,
     and scrolling opens the cloud that is already there. --open is how much
     scrolling it takes for the cloud to draw fully back; the three fields are
     revealed after that, one at a time, in the same frame.

     BASELINE FIRST. Everything below the @supports block is a plain, readable
     page: the mark, then the three fields in an ordinary column, all visible.
     That is what a crawler, a no-JS visitor and reduced motion get. Pinning
     and revealing are the enhancement, never the thing the content depends on
     — Googlebot renders at an expanded viewport and never scrolls, so a
     reveal that starts hidden would hide the whole site from it. */
  .frame { --open: 90vh; }

  /* Without JS the arrival is not a pinned frame, it is just the top of a
     readable page — so it must be free to grow, or the fields stacked beneath
     the mark overlap it. The 900px cap that .viewport-cap applies is a
     guardrail against Googlebot's expanded viewport, and Googlebot renders JS,
     so it is re-applied in the enhanced block below where it actually bites. */
  .arrival { max-height: none; }

  .glimpses {
    display: grid;
    gap: clamp(var(--space-16), 12vh, var(--space-32));
    justify-items: center;
    padding: clamp(var(--space-16), 12vh, var(--space-32)) var(--space-6) 0;
  }
  .glimpse {
    display: grid;
    justify-items: center;
    gap: var(--space-8);
    max-width: 40rem;
    text-decoration: none;
    color: inherit;
  }
  .glimpse__art {
    width: min(70vw, 560px);
    height: auto;
    /* A soft round bleed, never a rectangle: solid across the subject and
       dissolving only at the corners. */
    -webkit-mask-image: radial-gradient(closest-side circle at 50% 50%,
      #000 62%, rgba(0,0,0,.9) 78%, rgba(0,0,0,.45) 90%, transparent 100%);
    mask-image: radial-gradient(closest-side circle at 50% 50%,
      #000 62%, rgba(0,0,0,.9) 78%, rgba(0,0,0,.45) 90%, transparent 100%);
  }
  .glimpse__art--unformed {
    display: block;
    aspect-ratio: 1;
    background:
      radial-gradient(circle at 44% 40%, rgb(248 209 209 / .9) 0%, rgb(248 209 209 / 0) 46%),
      radial-gradient(circle at 58% 56%, rgb(190 236 206 / .95) 0%, rgb(190 236 206 / 0) 52%),
      radial-gradient(circle at 50% 50%, rgb(209 239 222 / .85) 0%, rgb(209 239 222 / 0) 68%);
  }
  .glimpse__word { display: grid; justify-items: center; text-align: center; }
  .glimpse__index {
    font-family: var(--font-display); font-weight: 600;
    font-size: var(--text-sm); letter-spacing: .34em;
    color: var(--mint-deep); margin-bottom: var(--space-3);
  }
  .glimpse__name {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(2.4rem, 5.4vw, 3.8rem); line-height: 1.04;
    letter-spacing: -.018em; color: var(--ink); margin-bottom: var(--space-4);
    transition: color var(--dur-ui) var(--ease-standard);
  }
  .glimpse--01 .glimpse__name { font-size: clamp(2.8rem, 6.4vw, 4.4rem); }
  .glimpse__line {
    font-size: clamp(1.0625rem, 1.35vw, 1.25rem);
    line-height: 1.62; color: var(--wood); max-width: 34ch;
  }
  .glimpse:hover .glimpse__name { color: var(--mint-deep); }
  .glimpse:focus-visible {
    outline: 3px solid var(--mint-deep);
    outline-offset: var(--space-6);
    border-radius: var(--radius-xl);
  }

  /* ── the enhancement: one pinned frame ───────────────────────────── */
  @supports (animation-timeline: scroll()) {
    /* One clock for the whole thing. Every timing below is a percentage of
       this scroll, so the cloud and the projects cannot drift out of step:
       the project is at full strength exactly while the cloud is open, and
       gone before it closes. The extra 100svh is the viewport itself — a
       scroll() range is measured against page height minus one viewport. */
    html.js .frame { height: calc(430vh + 100svh); }
    html.js .arrival {
      position: sticky;
      top: 0;
      min-height: min(100svh, 900px);
      max-height: min(100svh, 900px);
    }
    /* The fields stop being a column and become the thing inside the frame,
       stacked in one place and shown one at a time. */
    html.js .glimpses {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      padding: var(--space-8) var(--space-6);
      pointer-events: none;
      z-index: 4;
    }
    html.js .glimpse {
      grid-area: 1 / 1;
      opacity: 0;
      pointer-events: none;
      animation: glimpse-open linear both;
      animation-timeline: scroll(root);
    }
    /* Each window sits inside its own open phase of the cloud. */
    html.js .glimpse--01 { animation-range: 7% 32%; }
    html.js .glimpse--02 { animation-range: 39% 63%; }
    html.js .glimpse--03 {
      animation-name: glimpse-last;
      animation-range: 70% 100%;
    }
    html.js .glimpse__art { width: min(52vw, 460px); }
    html.js .glimpse--01 .glimpse__art { width: min(60vw, 540px); }
  }

  /* In and out inside the frame: it arrives set back, comes to full presence
     while it is the thing being read, then falls away as the next opens. */
  /* The last one holds. With the closing section gone, the experience ends on
     the field itself rather than on an empty opened frame. */
  @keyframes glimpse-last {
    0%   { opacity: 0; scale: .86; pointer-events: none; }
    22%  { opacity: 1; }
    60%, 100% { opacity: 1; scale: 1; pointer-events: auto; }
  }

  /* In while the cloud is drawing back, out before it closes again. */
  @keyframes glimpse-open {
    0%   { opacity: 0; scale: .88; pointer-events: none; }
    22%  { opacity: 1; }
    50%  { scale: 1; pointer-events: auto; }
    76%  { opacity: 1; }
    100% { opacity: 0; scale: 1.06; pointer-events: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    /* No pinning, no reveal: the plain readable column, still and complete. */
    html.js .frame { height: auto; }
    html.js .arrival { position: static; max-height: none; }
    html.js .glimpses { position: static; display: grid; pointer-events: auto; }
    html.js .glimpse {
      opacity: 1 !important;
      scale: none !important;
      pointer-events: auto;
      animation: none !important;
      grid-area: auto;
    }

    html.js .arrival :global(.mark__img),
    html.js .arrival__cue,
    html.js .arrival__cue svg {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .arrival__cue { transform: translateX(-50%) !important; }
    /* The floor only loses its animation. Blanket `transform: none` here
       would also strip its centring translate, and out-specify any attempt
       to put it back. */
    html.js .rest__floor { animation: none !important; }
  }
</style>
