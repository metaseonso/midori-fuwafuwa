---
import Layout from "../layouts/Layout.astro";
import World from "../components/World.astro";
import Mark from "../components/Mark.astro";
import Cloud from "../components/Cloud.astro";
import { withBase } from "../lib/url";

// Every word on this page is the founders' own, trimmed and never rewritten.
// Sources: ETHOS.md §"The studio" and §"What we make things for",
// PROJECT.md §"dream fields", productions/*/PROJECT.md (one line each).
// Nothing here is composed.
//
// Boundary (founder, 2026-08-19): "don't get lost in your fantasies — let's
// find ourselves through them" is WHIMSY's voice, not the studio's. It stays
// on the Whimsy field page, where it already sits with its full framing. Do
// not promote a production's line to studio level, however strong it reads.
---

<Layout
  title="Midori Fuwafuwa™ — a production studio based out of a Dreamland"
  description="A production studio based out of a Dreamland, shared by Seonso and Grumpy Carrot. Midori Fuwa Fuwa, and the different dream fields inside it."
>
  <main id="main" class="dream dreamground">
    <!-- ── arrival ────────────────────────────────────────────────────
         The mark, whole and uncropped, on its own cream. The logo's
         ground is #F4EDD6 (measured off the file's border), so the page
         is that colour and the image needs no cutout at all. -->
    <section class="arrival viewport-cap">
      <h1 class="visually-hidden">Midori Fuwafuwa Studio</h1>

      {/* Layered planes, bottom-heavy, so the arrival reads as a cloudscape
          with a floor rather than a gradient with decoration on it. Speeds
          are the reference's own scale: 100% is page speed, lower is further
          away. Front planes are kept low, where they graze past the mascot
          without ever crossing its face.

          Which plate can go where is not a taste call — it was measured off
          the alpha channel of each file:
            sky-far, sky-mid  dissolve top and bottom, hard left/right
                              → run wider than the viewport, edges off screen
            cloud-floor       dissolves at the top only
                              → pinned low, its sides and foot off screen
            island-misty      dissolves on all four edges → free to sit anywhere
            sky-near, sky-front  hard rectangles on ALL four edges, and
                              sky-near carries a straight cut inside the art
                              itself → unusable here at any size. The first
                              version used sky-near and put a hard horizontal
                              seam across the top of the hero.
          Nothing is faded to hide an edge — DESIGN_SYSTEM §6. */}
      <Cloud src="sky-far"      mode="hero" speed={0.76} w={130} top="-4%" layer="back"  depth={7}  drift={0} />
      <Cloud src="sky-mid"      mode="hero" speed={0.85} w={134} top="152%" layer="back"  depth={13} drift={0} flip />
      <Cloud src="island-base"  mode="hero" speed={0.95} w={40}  top="76%" left="89%" layer="front" depth={30} drift={21} flip />
      <Cloud src="island-misty" mode="hero" speed={0.98} w={44}  top="86%" left="12%" layer="front" depth={38} drift={17} />

      <Mark />
      <p class="arrival__cue" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 26 26" fill="none">
          <path
            d="M6 10.5l7 6.5 7-6.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </p>
    </section>

    <!-- ── stillness ─────────────────────────────────────────────────── -->
    <section class="creed">
      {/* The descent starts here, not at the fields. Sinking should be
          continuous: there is never a stretch of empty ground between one
          cloud passing and the next arriving. */}
      <Cloud src="island-misty" w={40} top="8%"  left="6%"   rise={20} approach={0.13} depth={26} drift={23} layer="front" />
      <Cloud src="sky-mid"      w={132} top="52%" rise={9}  approach={0.05} depth={9}  layer="back" flip />
      <Cloud src="motes"        w={20} top="86%" left="88%"  rise={26} approach={0.16} depth={34} drift={19} layer="front" />
      <p class="creed__line reveal">
        A production studio based out of <em>a Dreamland</em>, shared by
        Seonso and Grumpy&nbsp;Carrot.
      </p>
      <p class="creed__who reveal" style="--reveal-delay: 140ms;">
        She owns the muse. He owns the genius, as the Greeks say.
      </p>
    </section>

    <!-- ── descent ───────────────────────────────────────────────────
         Cloud banks hang at fixed depths through this whole stretch.
         `back` sits behind the worlds, `front` passes over them — that
         occlusion is what carries depth. -->
    <section class="descent">
      {/* Only the four assets whose painted edges dissolve on their own are
          used here. sky-mid / sky-near / sky-front / cloud-floor fill their
          frame to the pixel, so they end in a hard rectangle — the fix per
          DESIGN_SYSTEM §6 is to cut them, not to fade them into haze.
          sky-far touches its own left and right edges, so it is run wider
          than the viewport and those edges never come on screen.

          `front` banks are placed over the ART side of each world and never
          over its words. Depth, not lost legibility. */}
      <Cloud src="sky-far"      w={132} top="4%"  rise={7}  approach={0.04} depth={7}  layer="back" />
      <Cloud src="motes"        w={22}  top="14%" left="86%" rise={28} approach={0.18} depth={36} drift={17} layer="front" />
      <Cloud src="island-misty" w={44}  top="25%" left="7%"  rise={22} approach={0.14} depth={28} drift={25} layer="front" />
      <Cloud src="sky-mid"      w={132} top="42%" rise={10} approach={0.05} depth={10} layer="back" flip />
      <Cloud src="island-base"  w={46}  top="57%" left="95%" rise={24} approach={0.15} depth={30} drift={21} layer="front" flip />
      <Cloud src="motes"        w={26}  top="70%" left="14%" rise={30} approach={0.19} depth={38} drift={15} layer="front" />
      <Cloud src="island-base"  w={52}  top="84%" left="28%" rise={13} approach={0.07} depth={14} layer="back" />
      <Cloud src="island-misty" w={38}  top="94%" left="82%" rise={26} approach={0.16} depth={32} drift={27} layer="front" flip />

      <p class="descent__hinge reveal">
        Midori Fuwa Fuwa, and exploring the different dream fields.
      </p>

      <World
        index="01"
        title="The Kits"
        line="Seonso and Grumpy Carrot's children, on their journey exploring and learning about the many worlds around us."
        href={withBase("/fields/the-kits/")}
        depth={0.7}
        image={{
          webp: withBase("/images/fields/the-kits-reference.webp"),
          alt: "The Kits: a fox father in deep blue hanbok and a fox mother in floral pink, with four ginger fox-eared children, walking a lantern-lit forest path.",
          w: 640,
          h: 640,
        }}
      />

      <World
        index="02"
        title="Whimsy"
        flip
        depth={1}
        line="A magical fairy keeps your journal pages, notes and doodles safe — then sprinkles fairy dust to turn them into a world you can explore."
        href={withBase("/fields/whimsy/")}
        image={{
          webp: withBase("/images/fields/whimsy-reference.webp"),
          alt: "Whimsy: a lilac-haired fairy with iridescent wings hovering above an open journal, small green islands rising out of its written pages in a trail of gold sparkles.",
          w: 640,
          h: 640,
        }}
      />

      <World
        index="03"
        title="Couple App"
        line="Very us (Midori Fuwa Fuwa)."
        href={withBase("/fields/couple-app/")}
        depth={1.35}
        image={{
          webp: withBase("/images/dream/island-misty.webp"),
          alt: "A soft painted cloud island drifting alone, standing in for a field whose art is not drawn yet.",
          w: 900,
          h: 491,
        }}
      />
    </section>

    <!-- ── rest ──────────────────────────────────────────────────────── -->
    <section class="rest">
      <Cloud src="sky-mid"      w={132} top="6%"  rise={11} approach={0.06} depth={11} layer="back" />
      <Cloud src="island-misty" w={36}  top="22%" left="92%" rise={23} approach={0.15} depth={30} drift={21} layer="front" flip />
      <p class="rest__line reveal">We make it for ourselves too.</p>
      <p class="rest__body reveal" style="--reveal-delay: 140ms;">
        We want to be an entity that makes things beautifully and thoughtfully,
        and gets appreciated over time.
      </p>
      <p class="rest__door reveal" style="--reveal-delay: 260ms;">
        Happy to be reached out to.
      </p>
      <p class="rest__mark">Midori Fuwafuwa&trade;</p>

      {/* The floor of the dream. cloud-floor fills its own frame at the
          bottom and the sides, so it is pinned flush to the page edge and
          run wider than the viewport — every hard edge it has ends up off
          screen, and only its soft painted top is ever seen. */}
      <img
        class="rest__floor"
        src={withBase("/images/dream/cloud-floor.webp")}
        width="1200"
        height="670"
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      />
    </section>
  </main>
</Layout>

<style>
  /* Ground, --paper and the body colour now live in global.css as
     .dreamground — one definition shared with every dream field, so the
     landing and the fields can never drift apart again. */
  .dream { position: relative; }

  /* ── arrival ─────────────────────────────────────────────────────── */
  .arrival {
    display: grid;
    place-items: center;
    position: relative;
    padding: var(--space-12) var(--space-6) var(--space-24);
    isolation: isolate;
    /* No overflow clip, deliberately. Clipping the section drew a razor-
       straight line across the full width where the cloudscape met the next
       section — a hard rectangle, which is the one thing this design cannot
       have. So nothing is clipped; instead every plane here is one whose
       alpha dissolves at top and bottom, and it is simply allowed to carry
       on past the fold. `isolation: isolate` keeps them all inside this
       section's stacking context, so the copy below still paints over them.

       The cap from .viewport-cap, named so the planes can measure their
       travel against the section's real height (reference, point 4). */
    --range: min(100svh, 900px);
  }
  /* Warm light behind the mark. It reaches far past the logo's own edge and
     dissolves long before it stops, so the mark's cream ground and the page
     never meet at a line. */
  .arrival::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(132vw, 1040px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      closest-side circle,
      var(--paper) 0 30%,
      rgba(244, 237, 214, 0.9) 46%,
      rgba(244, 237, 214, 0.5) 68%,
      rgba(244, 237, 214, 0) 100%
    );
    z-index: -1;
    pointer-events: none;
  }

  .arrival__cue {
    position: absolute;
    z-index: 2;
    bottom: var(--space-12);
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    color: var(--sage);
  }

  /* Weightless, and a little late: the mark hangs before it lifts away. */
  @supports (animation-timeline: scroll()) {
    html.js .arrival :global(.mark__img) {
      animation: mark-away linear both;
      animation-timeline: scroll(root);
      animation-range: 0 78vh;
    }
    html.js .arrival__cue {
      animation: cue-away linear both;
      animation-timeline: scroll(root);
      animation-range: 0 22vh;
    }
  }
  @keyframes mark-away {
    0%   { transform: translateY(0) scale(1); opacity: 1; }
    38%  { transform: translateY(-8px) scale(1.005); opacity: 1; }
    100% { transform: translateY(-84px) scale(0.955); opacity: 0; }
  }
  @keyframes cue-away {
    to { opacity: 0; transform: translateX(-50%) translateY(10px); }
  }

  html.js .arrival__cue svg { animation: cue-breathe 3.4s var(--ease-standard) infinite; }
  @keyframes cue-breathe {
    0%, 100% { transform: translateY(0); opacity: 0.75; }
    50%      { transform: translateY(6px); opacity: 1; }
  }

  /* ── stillness ───────────────────────────────────────────────────── */
  .creed {
    position: relative;
    isolation: isolate;
    z-index: 2;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-12);
    padding: clamp(var(--space-24), 18vh, 200px) var(--space-6);
  }

  .creed__line {
    position: relative;
    z-index: 4;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.1rem, 5.4vw, 4.1rem);
    line-height: 1.16;
    letter-spacing: -0.018em;
    color: var(--ink);
    max-width: 21ch;
    text-wrap: balance;
    margin: 0;
  }
  .creed__line em {
    font-style: normal;
    color: var(--ink-green);
  }

  .creed__who {
    position: relative;
    z-index: 4;
    font-size: clamp(1.0625rem, 1.5vw, 1.35rem);
    line-height: 1.62;
    color: var(--wood);
    margin: 0;
  }

  /* ── descent ─────────────────────────────────────────────────────── */
  .descent {
    position: relative;
    z-index: 1;
    padding: 0 0 clamp(var(--space-16), 10vh, var(--space-32));
  }

  .descent__hinge {
    position: relative;
    z-index: 4;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.15rem, 1.9vw, 1.6rem);
    line-height: 1.5;
    color: var(--mint-deep);
    max-width: 40ch;
    margin: 0 auto clamp(var(--space-16), 9vh, var(--space-24));
    padding: 0 var(--space-6);
  }

  /* ── rest ────────────────────────────────────────────────────────── */
  .rest {
    position: relative;
    isolation: isolate;
    z-index: 2;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-8);
    padding: clamp(var(--space-24), 16vh, 190px) var(--space-6)
             clamp(380px, 48vh, 560px);
    overflow: clip;
  }
  .rest > p { position: relative; z-index: 2; }

  .rest__floor {
    position: absolute;
    bottom: -1px;
    left: 50%;
    width: 118vw;
    max-width: none;
    height: auto;
    transform: translateX(-50%);
    z-index: 0;
    pointer-events: none;
  }
  @supports (animation-timeline: scroll()) {
    html.js .rest__floor {
      animation: floor-rise linear both;
      animation-timeline: view();
      animation-range: entry 0% cover 70%;
    }
  }
  @keyframes floor-rise {
    from { transform: translateX(-50%) translateY(52px); }
    to   { transform: translateX(-50%) translateY(0); }
  }
  @media (max-width: 860px) {
    .rest__floor { width: 210vw; }
  }

  .rest__line {
    position: relative;
    z-index: 4;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 4.6vw, 3.4rem);
    line-height: 1.18;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0;
  }

  .rest__body {
    position: relative;
    z-index: 4;
    font-size: clamp(1.0625rem, 1.5vw, 1.35rem);
    line-height: 1.62;
    color: var(--wood);
    max-width: 36ch;
    margin: 0;
  }

  .rest__door {
    position: relative;
    z-index: 4;
    margin: var(--space-6) 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.6rem);
  }
  .rest__door { color: var(--mint-deep); }

  .rest__mark {
    position: relative;
    z-index: 4;
    margin: clamp(var(--space-16), 12vh, var(--space-32)) 0 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: 0.22em;
    /* Sits over the cloud floor, so it cannot be --sage: DESIGN_SYSTEM 1.6
       clears sage for large text only. --mint-deep holds ~5:1 on both the
       cream and the cloud. */
    color: var(--mint-deep);
  }

  @media (prefers-reduced-motion: reduce) {
    html.js .arrival :global(.mark__img),
    html.js .arrival__cue,
    html.js .arrival__cue svg {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .arrival__cue { transform: translateX(-50%) !important; }
    /* The floor only loses its animation. Blanket `transform: none` here
       would also strip its centring translate, and out-specify any attempt
       to put it back. */
    html.js .rest__floor { animation: none !important; }
  }
</style>
