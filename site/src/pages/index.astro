---
import Layout from "../layouts/Layout.astro";
import DreamSky from "../components/DreamSky.astro";
import SkyFront from "../components/SkyFront.astro";
import FieldVignette from "../components/FieldVignette.astro";
import { withBase } from "../lib/url";
---

<Layout
  title="Midori Fuwafuwa™ — The Dreamland"
  description="Seonso and Grumpy Carrot share a Dreamland. Scroll through the dream world, explore a field, see the forest within."
>
  <DreamSky />

  <main id="main" class="dreamworld">
    <!-- arrival: the logo's own art, at scale, with the mascot painting -->
    <section class="arrival">
      <div class="arrival__stack">
        <h1 class="visually-hidden">Midori Fuwafuwa Studio</h1>
        <img
          class="arrival__wordmark"
          src={withBase("/images/mark/wordmark.webp")}
          width="908" height="423"
          alt="" loading="eager" decoding="async"
        />
        <img
          class="arrival__mascot"
          src={withBase("/images/mark/mascot.webp")}
          width="625" height="650"
          alt="Midori Fuwafuwa's mascot: a small fluffy mint-green cloud painting at a wooden easel."
          loading="eager" decoding="async"
        />
        <img
          class="arrival__studio"
          src={withBase("/images/mark/studio.webp")}
          width="533" height="145"
          alt="" loading="eager" decoding="async"
        />
      </div>

      <p class="hint" aria-hidden="true">
        <span>scroll to drift</span>
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
          <path d="M4 7l6 6 6-6" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </p>
    </section>

    <section class="note">
      <p class="reveal">
        Seonso and Grumpy Carrot share a Dreamland — Midori Fuwa Fuwa, and the
        different <strong>dream fields</strong> inside it.
      </p>
    </section>

    <FieldVignette
      index="01"
      title="The Kits"
      line="Seonso and Grumpy Carrot's children, on their journey exploring the many worlds around us."
      href={withBase("/fields/the-kits/")}
      image={{
        webp: withBase("/images/fields/the-kits-reference.webp"),
        fallback: withBase("/images/fields/the-kits-reference.jpg"),
        width: 640, height: 640,
        alt: "The Kits: a fox-sage father and fox mother with four fox-eared children in hanbok, walking through a lantern-lit forest.",
      }}
    />

    <FieldVignette
      index="02"
      title="Whimsy"
      flip
      line="A fairy keeps your journals, notes, and doodles safe, then sprinkles fairy dust to turn them into a world you can explore."
      href={withBase("/fields/whimsy/")}
      image={{
        webp: withBase("/images/fields/whimsy-reference.webp"),
        fallback: withBase("/images/fields/whimsy-reference.jpg"),
        width: 640, height: 640,
        alt: "Whimsy: a small fairy with lilac hair and iridescent wings hovering over an open journal, floating islands rising from its pages.",
      }}
    />

    <FieldVignette
      index="03"
      title="Couple App"
      line="Very us (Midori Fuwa Fuwa)."
      href={withBase("/fields/couple-app/")}
      misty
    />

    <!-- the floor of the dream -->
    <section class="floor">
      <img
        class="floor__cloud"
        src={withBase("/images/dream/cloud-floor.webp")}
        alt="" loading="lazy" decoding="async"
      />
      <p class="floor__mark">Midori Fuwafuwa&trade;</p>
    </section>
  </main>

  <SkyFront />
</Layout>

<style>
  .dreamworld { position: relative; z-index: 2; }

  /* ---- arrival ---- */
  .arrival {
    min-height: min(100svh, 900px);
    display: grid;
    place-items: center;
    position: relative;
    padding: var(--space-8) var(--space-4);
  }
  .arrival__stack {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  /* Scale is set against the 900px viewport cap: the whole mark has to sit
     inside it with air around it, not fill it edge to edge. */
  .arrival__wordmark { width: min(58vw, 430px); }
  .arrival__mascot {
    width: min(34vw, 236px);
    margin-top: -7%;
  }
  .arrival__studio {
    width: min(19vw, 132px);
    margin-top: var(--space-3);
  }

  /* Sinking past the arrival: it rises away and thins out. Starts fully
     visible, so a crawler at scroll 0 sees the whole thing. */
  @supports (animation-timeline: scroll()) {
    html.js .arrival__stack {
      animation: arrival-away linear both;
      animation-timeline: scroll(root);
      animation-range: 0px 760px;
    }
    html.js .hint {
      animation: hint-away linear both;
      animation-timeline: scroll(root);
      animation-range: 0px 260px;
    }
  }
  @keyframes arrival-away {
    from { transform: translateY(0); opacity: 1; }
    to   { transform: translateY(-80px); opacity: 0; }
  }
  @keyframes hint-away { to { opacity: 0; } }

  .hint {
    position: absolute;
    bottom: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    color: var(--text-muted);
  }
  html.js .hint svg { animation: nod 1.9s var(--ease-standard) infinite; }
  @keyframes nod {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(5px); }
  }

  /* ---- the drifting line ---- */
  .note {
    min-height: min(62svh, 560px);
    display: grid;
    place-items: center;
    padding: var(--space-8) var(--space-4);
  }
  .note p {
    max-width: 32ch;
    text-align: center;
    font-size: clamp(1.2rem, 2.2vw, 1.7rem);
    line-height: 1.45;
    margin: 0;
  }
  .note strong { color: var(--accent-text); font-weight: 700; }

  /* ---- the floor ---- */
  .floor {
    min-height: min(80svh, 700px);
    display: grid;
    place-items: end center;
    position: relative;
    padding-bottom: var(--space-16);
  }
  .floor__cloud {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 150vw;
    max-width: none;
    transform: translateX(-50%);
    pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 30%, #000 100%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 30%, #000 100%);
  }
  .floor__mark {
    position: relative;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
    color: var(--text-muted);
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    html.js .arrival__stack,
    html.js .hint,
    html.js .hint svg {
      animation: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
    .hint { transform: translateX(-50%) !important; }
  }
</style>
